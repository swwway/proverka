#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""Карта ключей: какой секрет в каких файлах повторяется.

ЗАЧЕМ. Ротация промахивается не потому, что забыли поменять ключ, а потому что
не знали про все места, где он лежит. Меняешь в одном файле — служба, читающая
второй, ломается ночью; или наоборот, старый ключ остаётся жить и остаётся
годен. Знать надо ДО ротации, а не после.

ЧТО ДЕЛАЕТ. Ищет значения, похожие на ключи, считает от каждого отпечаток и
группирует файлы по отпечатку. Показывает: вид ключа, отпечаток, список файлов.

ЧЕГО НЕ ДЕЛАЕТ. НИКОГДА не печатает само значение и никуда его не записывает —
ни в вывод, ни в файл. Наружу идёт только отпечаток (первые 8 знаков sha256),
которого достаточно, чтобы сказать «это тот же ключ», и недостаточно, чтобы его
узнать. Ничего не меняет: только смотрит.

🔒 ~/Personal НЕ ТРОГАЕТ ВООБЩЕ — закрытый контур, туда нельзя ни фоном, ни
по расписанию, ни «просто посмотреть».
"""
import hashlib
import os
import re
import sys

# Куда смотреть. Осознанно узко: там, где ключи живут на самом деле.
# Переопределяется PROVERKA_ROOTS — не для гибкости, а чтобы прибор можно было
# натравить на заведомо известный случай и убедиться, что он зрячий. Вывод «ключей
# не найдено» без такой проверки не значит ничего.
_ПО_УМОЛЧАНИЮ = [
    "~/.secrets",
    "~/businesses",
    "~/apps",
    "~/artemis",
    "/etc/systemd/system",
    "~/.config/systemd/user",
]
КОРНИ = [к for к in os.environ.get("PROVERKA_ROOTS", "").split(":") if к] \
        or _ПО_УМОЛЧАНИЮ

# 🔒 Закрытый контур и мусор, куда ходить незачем.
ЗАПРЕТ = ("~/Personal", "~/personal")
ПРОПУСК = {"node_modules", ".git", ".next", "dist", "build", "__pycache__",
           ".venv", "venv", "coverage", "backups", "logs", ".cache",
           "evidence", ".pytest_cache", "worktrees"}

# Файлы, где ключи бывают. Расширять список дешевле, чем читать весь диск.
ИНТЕРЕСНЫЕ = re.compile(
    r"(\.env(\..+)?$|^\.env|\.envrc$|\.key$|\.token$|\.secret$|"
    r"\.service$|\.timer$|credentials|CREDENTIALS|\.pem$|"
    r"config\.(toml|json|ya?ml)$|secrets?\.(ya?ml|json|toml)$)")

ПРЕДЕЛ_РАЗМЕРА = 512 * 1024   # больше — это не файл с ключами

ВИДЫ = [
    ("токен телеграм-бота", re.compile(r"\b[0-9]{8,11}:[A-Za-z0-9_-]{35}\b")),
    ("ключ Anthropic",      re.compile(r"\bsk-(?:ant|a)-[A-Za-z0-9_-]{20,}")),
    ("ключ OpenAI",         re.compile(r"\bsk-(?:proj-)?[A-Za-z0-9_-]{32,}")),
    ("ключ Groq",           re.compile(r"\bgsk_[A-Za-z0-9]{40,}")),
    ("ключ ElevenLabs",     re.compile(r"\bsk_[a-f0-9]{48}\b")),
    ("токен Cloudflare",    re.compile(r"\bcfut[A-Za-z0-9_-]{30,}")),
    ("токен GitHub",        re.compile(r"\bgh[pousr]_[A-Za-z0-9]{36,}")),
    ("закрытый ключ age",   re.compile(r"AGE-SECRET-KEY-1[A-Z0-9]{50,}")),
    # Опознаём AWS по идентификатору (AKIA…), а не по самому секрету: секрет —
    # это 40 знаков base64 без опознавательных примет, и ловля по такой форме
    # даёт ложные срабатывания на хэшах и подписях. Идентификатор лежит рядом
    # с секретом всегда, поэтому для КАРТЫ он и нужен: место указано верно.
    ("ключ AWS",            re.compile(r"\bAKIA[0-9A-Z]{16}\b")),
    ("строка к базе",       re.compile(r"postgres(?:ql)?://[A-Za-z0-9_.-]+:([^@\s\"']{8,})@")),
]

# Заглушки: их находить не надо, это образцы, а не ключи.
ЗАГЛУШКА = re.compile(
    r"(?i)(your[_-]?|xxx+|<[a-z_]+>|\$\{[A-Z_]+\}|replace_?me|changeme|"
    r"example|placeholder|dummy|\.\.\.|…)")


def отпечаток(значение):
    """Короткий след значения. Узнать по нему ключ нельзя, сравнить — можно."""
    return hashlib.sha256(значение.encode("utf-8", "replace")).hexdigest()[:8]


def под_запретом(путь):
    п = os.path.abspath(путь)
    return any(п == з or п.startswith(з + os.sep) for з in ЗАПРЕТ)


def файлы():
    for корень in КОРНИ:
        if not os.path.isdir(корень) or под_запретом(корень):
            continue
        for путь, папки, имена in os.walk(корень):
            if под_запретом(путь):
                папки[:] = []
                continue
            папки[:] = [d for d in папки
                        if d not in ПРОПУСК and not под_запретом(os.path.join(путь, d))]
            for имя in имена:
                if not ИНТЕРЕСНЫЕ.search(имя):
                    continue
                полный = os.path.join(путь, имя)
                try:
                    if os.path.getsize(полный) > ПРЕДЕЛ_РАЗМЕРА:
                        continue
                except OSError:
                    continue
                yield полный


def main():
    найдено = {}      # отпечаток -> {"вид": ..., "файлы": set()}
    просмотрено = 0
    for путь in файлы():
        try:
            with open(путь, encoding="utf-8", errors="replace") as ф:
                текст = ф.read(ПРЕДЕЛ_РАЗМЕРА)
        except (OSError, PermissionError):
            continue
        просмотрено += 1
        for вид, рег in ВИДЫ:
            for м in рег.finditer(текст):
                значение = м.group(1) if рег.groups else м.group(0)
                if ЗАГЛУШКА.search(значение):
                    continue
                о = отпечаток(значение)
                запись = найдено.setdefault(о, {"вид": вид, "файлы": set()})
                запись["файлы"].add(путь)

    if просмотрено == 0:
        print("2 · НЕ ПРОВЕРЕНО — не удалось прочитать ни одного файла "
              "(права или пути)")
        return 2

    повторы = {о: з for о, з in найдено.items() if len(з["файлы"]) > 1}

    print("КАРТА КЛЮЧЕЙ — где что лежит (значения НЕ показываются)")
    print("═" * 74)
    print(f"Просмотрено файлов: {просмотрено} · разных ключей: {len(найдено)} · "
          f"из них лежат больше чем в одном месте: {len(повторы)}")
    print()

    if повторы:
        print("⚠️  ЭТИ КЛЮЧИ ПРИ РОТАЦИИ НАДО МЕНЯТЬ ВЕЗДЕ СРАЗУ")
        print("─" * 74)
        for о, з in sorted(повторы.items(),
                           key=lambda п: -len(п[1]["файлы"])):
            print(f"  {з['вид']} · отпечаток {о} · мест: {len(з['файлы'])}")
            for ф in sorted(з["файлы"]):
                print(f"      {ф}")
            print()
    else:
        print("Повторов нет: каждый ключ лежит ровно в одном месте.")
        print()

    одиночки = {о: з for о, з in найдено.items() if len(з["файлы"]) == 1}
    if одиночки:
        print("Остальные — по одному месту каждый:")
        print("─" * 74)
        по_видам = {}
        for о, з in одиночки.items():
            по_видам.setdefault(з["вид"], []).append((о, list(з["файлы"])[0]))
        for вид in sorted(по_видам):
            print(f"  {вид}: {len(по_видам[вид])} шт.")
            for о, ф in sorted(по_видам[вид], key=lambda п: п[1]):
                print(f"      {о}  {ф}")
        print()

    print("С ЧЕГО СНЯТО: " + ", ".join(КОРНИ))
    print("🔒 ~/Personal не просматривался — закрытый контур.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
