#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""Учение по восстановлению боевых баз.

ЗАЧЕМ. Копия, которую ни разу не разворачивали, — это НЕ копия, а надежда.
Проверено на этой же машине 15.08: дампы лежат под именами `*.sql.gz`, и любой,
кто в аварии наберёт привычное `zcat дамп | psql`, получит отказ — внутри не
текст, а двоичный формат PGDMP (pg_dump -Fc). То есть заготовленный способ
восстановления не работал бы ровно в тот момент, когда он нужен.

ЧТО ДЕЛАЕТ. Берёт САМЫЙ СВЕЖИЙ дамп каждой базы, поднимает одноразовый
постгрес в отдельном контейнере, разворачивает туда и считает, что получилось.
Боевые базы не трогает вовсе: другой сервер, другой контейнер, другое имя.

ЧЕМ ОТЛИЧАЕТСЯ ОТ «gzip -t». Целостность архива говорит лишь, что файл не бит.
Она НЕ говорит, что дамп развернётся и что внутри есть данные. Пустая база
разворачивается успешно — и по коду возврата это «успех».
Поэтому здесь красным считается не только отказ, но и:
  · таблиц ноль (развернулось пустое),
  · строк стало заметно меньше, чем в прошлый раз (база усохла молча).

ТРИ ИСХОДА, как и у остальных приборов: 0 — зелено, 1 — красно,
2 — НЕ ПРОВЕРЕНО (нет дампов, нет докера, стенд не поднялся). «Не знаю»
никогда не показывается зелёным.
"""
import json
import os
import re
import subprocess
import sys
import time
from datetime import datetime, timezone

ЗЕЛЕНО, КРАСНО, НЕ_ПРОВЕРЕНО = 0, 1, 2

# Пути настраиваемые НЕ ради гибкости, а ради испытания порчей: прибор надо
# уметь натравить на заведомо битую копию и увидеть красное, не трогая настоящие
# копии и не пачкая настоящий эталон. Проверка, которая не умеет краснеть, —
# это не проверка, а успокоительное.
ДАМПЫ = os.environ.get("PROVERKA_DUMPS", "~/backups/prod-dumps")
ЭТАЛОН = os.environ.get("PROVERKA_ETALON",
                        "~/.claude/vosstanovlenie-эталон.json")
СТЕНД = os.environ.get("PROVERKA_STAND", "proverka-vosst-stend")
ОБРАЗ = "postgres:16-alpine"
ЖУРНАЛ = "~/logs/vosstanovlenie.log"

# Дамп старше этого — уже не проверка свежей копии, а проверка музейного экспоната.
СВЕЖЕСТЬ_ЧАСОВ = 36
# Просадка строк, ниже которой считаем, что база усохла молча.
ДОПУСТИМАЯ_УСУШКА = 0.20


def сказать(строка):
    os.makedirs(os.path.dirname(ЖУРНАЛ), exist_ok=True)
    метка = datetime.now(timezone.utc).strftime("%F %T")
    with open(ЖУРНАЛ, "a", encoding="utf-8") as ф:
        ф.write(f"[{метка}] {строка}\n")


def выполнить(команда, ввод=None, предел=1800):
    try:
        п = subprocess.run(команда, input=ввод, capture_output=True,
                           text=True, timeout=предел)
        return п.returncode, п.stdout, п.stderr
    except subprocess.TimeoutExpired:
        return 124, "", f"не уложился в {предел}с"
    except FileNotFoundError as e:
        return 127, "", str(e)


def свежие_дампы():
    """Самый свежий дамп каждой базы. Имя вида <база>_<дата>T<время>.sql.gz."""
    if not os.path.isdir(ДАМПЫ):
        return {}
    рег = re.compile(r"^(?P<база>.+)_\d{4}-\d{2}-\d{2}T\d+\.sql\.gz$")
    лучшее = {}
    for имя in os.listdir(ДАМПЫ):
        м = рег.match(имя)
        if not м:
            continue
        путь = os.path.join(ДАМПЫ, имя)
        try:
            когда = os.path.getmtime(путь)
        except OSError:
            continue
        база = м.group("база")
        if база not in лучшее or когда > лучшее[база][1]:
            лучшее[база] = (путь, когда)
    return лучшее


def поднять_стенд():
    выполнить(["docker", "rm", "-f", "-v", СТЕНД], предел=60)
    код, _, ош = выполнить([
        "docker", "run", "-d", "--name", СТЕНД,
        "-e", "POSTGRES_PASSWORD=drill", "-e", "POSTGRES_USER=drill",
        ОБРАЗ], предел=300)
    if код != 0:
        return False, ош.strip()[:200]
    for _ in range(60):
        код, _, _ = выполнить(["docker", "exec", СТЕНД, "pg_isready", "-U", "drill"],
                              предел=30)
        if код == 0:
            return True, ""
        time.sleep(1)
    return False, "стенд не ответил за минуту"


def убрать_стенд():
    """-v ОБЯЗАТЕЛЕН. Без него контейнер уходит, а его безымянный том остаётся:
    образ postgres объявляет том сам, и каждый прогон учения оставлял на диске
    около 1,4 ГБ. Обнаружено 23.08 при уборке докера — четыре таких тома, 5,7 ГБ,
    все от этого прибора. Прибор, который сам засоряет машину, чинит одно и
    ломает другое."""
    выполнить(["docker", "rm", "-f", "-v", СТЕНД], предел=120)


def запрос(база, sql):
    код, вывод, ош = выполнить(
        ["docker", "exec", "-i", СТЕНД, "psql", "-U", "drill", "-d", база,
         "-t", "-A", "-c", sql], предел=600)
    return код, вывод.strip(), ош.strip()


def развернуть(база, путь):
    """Возвращает (получилось, число_ошибок, первая_ошибка)."""
    код, _, ош = выполнить(["docker", "exec", СТЕНД, "createdb", "-U", "drill", база],
                           предел=120)
    if код != 0 and "already exists" not in ош:
        return False, 1, f"базу не создать: {ош.strip()[:160]}"

    # Поток, а не временный файл: дампы бывают в гигабайты, лишнее место ни к чему.
    #
    # ВИД КОНВЕЙЕРА ВАЖЕН. Через `stdin=PIPE` + ручное закрытие получается
    # «flush of closed file»: communicate() пытается дослать во вход, который мы
    # уже закрыли. Проверено 15.08 — падало на первой же базе. Правильно наоборот:
    # труба принадлежит zcat, а pg_restore берёт её как свой вход.
    распаковка = subprocess.Popen(["zcat", путь], stdout=subprocess.PIPE,
                                  stderr=subprocess.DEVNULL)
    развёртка = subprocess.Popen(
        ["docker", "exec", "-i", СТЕНД, "pg_restore", "-U", "drill", "-d", база,
         "--no-owner", "--no-privileges"],
        stdin=распаковка.stdout, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
        # text=True ОБЯЗАТЕЛЕН. Без него вывод приходит байтами, и разбор ошибок
        # падает с TypeError — но ТОЛЬКО когда ошибки есть, то есть ровно в тот
        # раз, когда прибор обязан покраснеть. В зелёном случае stderr пустой,
        # проверка проскакивает, и поломка не видна. Найдено испытанием порчей
        # 15.08: обрезанный дамп дал «не проверено» вместо «красно».
        text=True, errors="replace")
    распаковка.stdout.close()  # свой конец отдаём развёртке целиком
    try:
        _, ошибки = развёртка.communicate(timeout=3600)
    except subprocess.TimeoutExpired:
        развёртка.kill()
        распаковка.kill()
        return False, 1, "восстановление не уложилось в час"
    распаковка.wait()

    строки = [с for с in (ошибки or "").splitlines() if "error" in с.lower()]
    первая = строки[0][:200] if строки else ""
    # pg_restore возвращает 1 и при «предупреждениях, но данные легли».
    # Поэтому решаем не по коду, а по тому, что реально оказалось внутри.
    return True, len(строки), первая


def дамп_пуст(путь):
    """Пуст ли САМ дамп (нет ни одной таблицы в описи).

    ЗАЧЕМ ОТЛИЧАТЬ. «Развернулось пустым» бывает по двум причинам, и они
    противоположны: либо восстановление сломано (беда), либо на источнике и
    правда ничего нет (норма). Проверено 15.08 на базе otc: 467 байт, в описи
    одна строка про права на схему, на боевом сервере у неё ноль таблиц —
    копия честная. Если такое звать красным, прибор будет кричать одинаково
    каждый прогон, а на крик, который повторяется всегда, ходить перестают.

    Потерю данных это НЕ прячет: если у базы РАНЬШЕ были таблицы, а теперь ноль,
    краснеет проверка усушки — она смотрит на эталон прошлого прогона.
    """
    расп = subprocess.Popen(["zcat", путь], stdout=subprocess.PIPE,
                            stderr=subprocess.DEVNULL)
    опись = subprocess.Popen(["docker", "exec", "-i", СТЕНД, "pg_restore", "-l"],
                             stdin=расп.stdout, stdout=subprocess.PIPE,
                             stderr=subprocess.DEVNULL,
                             text=True, errors="replace")  # см. пояснение выше
    расп.stdout.close()
    try:
        вывод, _ = опись.communicate(timeout=900)
    except subprocess.TimeoutExpired:
        опись.kill()
        расп.kill()
        return False          # не разобрали — считаем, что не пуст: пусть краснеет
    расп.wait()
    таблиц = [с for с in (вывод or "").splitlines()
              if с and not с.lstrip().startswith(";") and " TABLE " in с]
    return len(таблиц) == 0


def замерить(база):
    """Сколько таблиц и строк реально легло."""
    код, _, _ = запрос(база, "ANALYZE;")
    код, вывод, ош = запрос(база, """
        SELECT count(*)::text || '|' || COALESCE(sum(c.reltuples)::bigint, 0)::text
        FROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace
        WHERE c.relkind = 'r' AND n.nspname NOT IN ('pg_catalog','information_schema');
    """)
    if код != 0 or "|" not in вывод:
        return None, None
    таблиц, строк = вывод.split("|")[:2]
    try:
        return int(таблиц), int(float(строк))
    except ValueError:
        return None, None


def прочитать_эталон():
    try:
        with open(ЭТАЛОН, encoding="utf-8") as ф:
            return json.load(ф)
    except Exception:
        return {}


def записать_эталон(данные):
    os.makedirs(os.path.dirname(ЭТАЛОН), exist_ok=True)
    with open(ЭТАЛОН, "w", encoding="utf-8") as ф:
        json.dump(данные, ф, ensure_ascii=False, indent=2, sort_keys=True)


def main():
    сказать("=== учение начато ===")
    дампы = свежие_дампы()
    if not дампы:
        print("2 · НЕ ПРОВЕРЕНО — дампов нет в " + ДАМПЫ)
        сказать("НЕ ПРОВЕРЕНО: дампов нет")
        return НЕ_ПРОВЕРЕНО

    код, _, _ = выполнить(["docker", "info"], предел=60)
    if код != 0:
        print("2 · НЕ ПРОВЕРЕНО — докер недоступен, стенд поднять не на чем")
        сказать("НЕ ПРОВЕРЕНО: докер недоступен")
        return НЕ_ПРОВЕРЕНО

    поднялся, почему = поднять_стенд()
    if not поднялся:
        print(f"2 · НЕ ПРОВЕРЕНО — стенд не поднялся: {почему}")
        сказать(f"НЕ ПРОВЕРЕНО: стенд не поднялся ({почему})")
        убрать_стенд()
        return НЕ_ПРОВЕРЕНО

    эталон = прочитать_эталон()
    новый_эталон = dict(эталон)
    итоги = []
    сейчас = time.time()

    try:
        for база in sorted(дампы):
            путь, когда = дампы[база]
            часов = (сейчас - когда) / 3600
            размер = os.path.getsize(путь) / 1048576

            если_старый = часов > СВЕЖЕСТЬ_ЧАСОВ
            начало = time.time()
            легло, ошибок, первая = развернуть(база, путь)
            таблиц, строк = замерить(база) if легло else (None, None)
            секунд = int(time.time() - начало)

            было = эталон.get(база, {})
            усушка = None
            if строк is not None and было.get("строк"):
                усушка = 1 - (строк / было["строк"]) if было["строк"] else 0

            плохо = []
            пусто_на_источнике = False
            if not легло:
                плохо.append(первая or "не развернулось")
            elif таблиц is None:
                плохо.append("развернулось, но пересчитать не удалось")
            elif таблиц == 0:
                # Развернулось пустым — но по чьей вине? Смотрим в саму опись дампа.
                if дамп_пуст(путь):
                    пусто_на_источнике = True
                else:
                    плохо.append("развернулось ПУСТОЕ, хотя в дампе таблицы ЕСТЬ — "
                                 "восстановление сломано")
            elif ошибок > 0:
                плохо.append(f"{ошибок} ошибок при развёртке: {первая}")
            if усушка is not None and усушка > ДОПУСТИМАЯ_УСУШКА:
                плохо.append(f"строк меньше на {усушка*100:.0f}% "
                             f"(было {было['строк']}, стало {строк})")
            if если_старый:
                плохо.append(f"дамп старше {СВЕЖЕСТЬ_ЧАСОВ}ч ({часов:.0f}ч)")

            итоги.append({
                "база": база, "таблиц": таблиц, "строк": строк,
                "секунд": секунд, "мб": размер, "часов": часов,
                "плохо": плохо, "пусто": пусто_на_источнике,
            })
            if таблиц:
                новый_эталон[база] = {
                    "таблиц": таблиц, "строк": строк,
                    "снято": datetime.now(timezone.utc).strftime("%F %T"),
                }
    finally:
        убрать_стенд()

    записать_эталон(новый_эталон)

    красных = [и for и in итоги if и["плохо"]]
    print()
    print("ВОССТАНОВЛЕНИЕ БОЕВЫХ БАЗ — учение на одноразовом стенде")
    print("─" * 74)
    print(f"{'база':<18} {'таблиц':>7} {'строк':>12} {'дамп МБ':>9} {'сек':>5}  итог")
    print("─" * 74)
    for и in итоги:
        метка = "🔴" if и["плохо"] else ("⚪" if и["пусто"] else "🟢")
        т = "—" if и["таблиц"] is None else f"{и['таблиц']}"
        с = "—" if и["строк"] is None else f"{и['строк']:,}".replace(",", " ")
        print(f"{и['база']:<18} {т:>7} {с:>12} {и['мб']:>9.1f} {и['секунд']:>5}  {метка}")
        for п in и["плохо"]:
            print(f"    └─ {п}")
        # Успокаивающую строку печатаем ТОЛЬКО когда красного нет: рядом с
        # красным она читается как оправдание и сбивает с толку того, кто
        # разбирается в аварии.
        if и["пусто"] and not и["плохо"]:
            print("    └─ пусто и на источнике — копия честная, защищать тут нечего")
    print("─" * 74)

    первый_раз = not эталон
    if первый_раз:
        print("Это первое учение — числа записаны как эталон, "
              "в следующий раз усушка будет видна.")
    print(f"С ЧЕГО СНЯТО: самые свежие дампы в {ДАМПЫ}, "
          f"развёрнуты в {ОБРАЗ} внутри одноразового контейнера.")

    сказать(f"итог: баз {len(итоги)}, красных {len(красных)}")
    if красных:
        print(f"\n1 · КРАСНО — {len(красных)} из {len(итоги)} баз не восстанавливаются как надо")
        return КРАСНО
    # Итог обязан совпадать с таблицей выше. «Все N не пустые» при одной пустой —
    # мелкая, но всё та же ложь зелёным, а с мелких она и начинается.
    пустых = len([и for и in итоги if и["пусто"]])
    с_данными = len(итоги) - пустых
    хвост = f"; ещё {пустых} пусты на самом источнике" if пустых else ""
    print(f"\n0 · ЗЕЛЕНО — восстановление работает: {с_данными} баз с данными "
          f"развернулись целиком{хвост}")
    return ЗЕЛЕНО


if __name__ == "__main__":
    # ПАДЕНИЕ САМОГО ПРИБОРА — ЭТО «НЕ ПРОВЕРЕНО», А НЕ «ЗЕЛЕНО».
    # Проверено 15.08: первый прогон рухнул на первой базе, а наружу ушёл код 0 —
    # вывод шёл через `| tail`, и код взялся от tail. Прибор, который при
    # собственной поломке показывает зелёное, опаснее отсутствия прибора.
    # Поэтому: любое необработанное падение → 2, и стенд убираем в любом случае.
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        убрать_стенд()
        print("\n2 · НЕ ПРОВЕРЕНО — учение прервано вручную")
        sys.exit(НЕ_ПРОВЕРЕНО)
    except Exception as сбой:
        import traceback
        убрать_стенд()
        traceback.print_exc()
        сказать(f"ПРИБОР УПАЛ: {type(сбой).__name__}: {сбой}")
        print(f"\n2 · НЕ ПРОВЕРЕНО — упал сам прибор: {type(сбой).__name__}: {сбой}")
        sys.exit(НЕ_ПРОВЕРЕНО)
