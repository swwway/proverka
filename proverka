def режим_zadanie(корень, слать=False, писать=True):
    корень = os.path.abspath(корень)
    конфиг = прочитать_конфиг(корень) or {}
    имя_пр = os.path.basename(корень)
    строки = [f"# Задание: чего не хватает проверкам — {имя_пр}", ""]
    строки.append("Составлено прибором из замеров. Числа не оценены, а измерены;")
    строки.append("каждое можно перепроверить командой, указанной рядом.")
    строки.append("")
    есть_работа = False

    # 1. Обязательные виды, которых нет
    деньги = (конфиг.get("деньги") or {}).get("есть") if isinstance(
        конфиг.get("деньги"), dict) else None
    команды = конфиг.get("команды") or {}
    # ПУСТОТА — НЕ ПОРЯДОК. Проект, где не заведено НИ ОДНОЙ проверки, получал
    # отсюда «нехватки не нашлось» и код 0: мерить было нечем, а наружу уходило
    # зелёное. Это тот же «ноль проверок под кодом 0», ради которого весь прибор
    # и написан, только в другом режиме (поймано 15.09.2026 на хранилище без
    # проверок). Теперь — честное «не проверено», и файл задания не пишется:
    # задание, составленное из ничего, врёт самим фактом своего существования.
    if not команды:
        print(f"# Задание: {имя_пр}\n\nНЕ ПРОВЕРЕНО — проверки здесь ещё не "
              f"заводились, мерить нечего.\n  Завести: proverka init {корень}")
        return НЕ_ПРОВЕРЕНО
    нехватка = []
    for вид, улика, решено in виды_проверок(определить(корень), деньги):
        ключ = вид.split(":")[0].strip()
        if ключ in (конфиг.get("перебито_видами") or {}):
            continue
        if not решено:
            нехватка.append((вид, улика, "не спрошено"))
    if нехватка:
        есть_работа = True
        строки.append("## Не определено — сначала ответь")
        for вид, улика, _ in нехватка:
            строки.append(f"- **{вид}** — {улика}")
        строки.append("")

    # 2. Замер зубами: что можно сломать незаметно
    зубы = конфиг.get("порчи_проверены")
    if isinstance(зубы, dict):
        поймано, всего = зубы.get("поймано", 0), зубы.get("подложено", 0)
        прицел = (зубы.get("прицел") or "").strip()
        # 10 из 10 по ОДНОМУ файлу — это не покрытие, а узкий замер. Молчать об
        # этом значит выдавать льстивую цифру за доказательство.
        if всего and поймано == всего and прицел and прицел != "весь проект":
            есть_работа = True
            строки.append("## Замер узкий — покрытием он не является")
            строки.append(f"Поймано {поймано} из {всего}, но прицел был только "
                          f"«{прицел}». Про остальной код прибор не знает ничего.")
            строки.append("")
            строки.append("Померить широко: `proverka teeth <проект> --сколько 20` "
                          "(без --только).")
            строки.append("")
        if всего and поймано < всего:
            есть_работа = True
            строки.append("## Можно сломать, и никто не заметит")
            строки.append(f"Подложено порч: **{всего}**, поймано: **{поймано}** "
                          f"({зубы.get('доля')}). Прицел: {зубы.get('прицел')}, "
                          f"{(зубы.get('когда') or '')[:10]}.")
            строки.append("")
            строки.append("Перепроверить: `proverka teeth <проект> --сколько "
                          f"{всего}`. Выборка каждый раз новая — подогнать проверку")
            строки.append("под известную порчу нельзя.")
            строки.append("")

    # 3. Пропущенное: разделяем «нет проверки» и «негде запустить»
    for имя, команда in list(команды.items())[:4]:
        r = запустить(команда, корень, 900)
        счёт = посчитать(r["вывод"]) or {}
        проп = счёт.get("пропущено", 0)
        упало = счёт.get("упало", 0)
        if упало:
            есть_работа = True
            строки.append(f"## Красное прямо сейчас: {имя}")
            строки.append(f"Упало **{упало}** из {счёт.get('всего')}. "
                          f"Перепроверить: `{команда}`")
            строки.append("")
        if проп:
            причины = re.findall(r"SKIPPED \[(\d+)\][^:]*: (.{0,90})", r["вывод"])
            if not причины and "pytest" in команда:
                # без -rs причины не печатаются. Спрашиваем отдельно — иначе
                # «пропущено 110» остаётся числом без смысла.
                r2 = запустить(команда + " -rs", корень, 900)
                причины = re.findall(r"SKIPPED \[(\d+)\][^:]*: (.{0,90})", r2["вывод"])
            свод = {}
            for n, поч in причины:
                ключ = ("НЕГДЕ ЗАПУСТИТЬ" if re.search(
                    r"requires|not set|not available|no .* samples", поч, re.I)
                    else "нет проверки / известный баг")
                свод[ключ] = свод.get(ключ, 0) + int(n)
            есть_работа = True
            строки.append(f"## Пропущено в {имя}: {проп}")
            for к, v in sorted(свод.items(), key=lambda x: -x[1]):
                строки.append(f"- **{v}** — {к}")
            строки.append("")
            строки.append("«Негде запустить» — это работа по стенду, а не по проверкам.")
            строки.append("")

    if not есть_работа:
        строки.append("Нехватки не нашлось. Это не значит «всё покрыто» —")
        строки.append("значит, приборы не видят непокрытого. Расширь прицел зубов.")

    текст = "\n".join(строки[:200])
    print(текст)
    if писать:
        п = os.path.join(корень, "ЗАДАНИЕ-ПРОВЕРКИ.md")
        open(п, "w", encoding="utf-8").write(текст + "\n")
        print(f"\n(записано: {п})")
    if слать and есть_работа:
        в_телеграм(f"📋 Задание на проверки: {имя_пр}\n\n" + текст[:2500])
    return ЗЕЛЕНО if not есть_работа else НЕ_ПРОВЕРЕНО


def _крон_запускал(строка_крона, часов):
    """Запускал ли крон эту команду за последние N часов. Настоящий признак жизни.

    Свежесть журнала — признак КОСВЕННЫЙ и у журналов «только при сбое» перевёрнутый.
    Прямой признак один: крон записал факт запуска.
    """
    m = re.search(r"(/[\w./-]+\.(?:sh|py|mjs|js))", строка_крона)
    if not m:
        return False
    метка = os.path.basename(m.group(1))
    try:
        r = subprocess.run(
            ["sudo", "journalctl", "-u", "cron", "--since", f"{int(часов)+1} hours ago",
             "--no-pager"], capture_output=True, text=True, timeout=60)
        return метка in (r.stdout or "")
    except Exception:
        return False


def режим_watch(корень, слать=False, строго=False):
    корень = os.path.abspath(корень)
    конфиг = прочитать_конфиг(корень)
    if конфиг is None:
        print(f"Проверка здесь не заведена ({CONFIG_NAME} нет).")
        return НЕ_ПРОВЕРЕНО
    сторожа = конфиг.get("сторож") or []
    if not сторожа:
        print("Сторожить нечего: в расписании нет строки, которая пишет лог.")
        return НЕ_ПРОВЕРЕНО

    живые_строки = строки_крона(корень)
    беды, порядок = [], []

    # Своя строка есть в расписании, а журнала нет и проект заведён давно —
    # значит проверка не запускалась НИ РАЗУ. Без этого дыра только сдвигается:
    # журнал не появился — строка не в сторожах — тишина снова не ловится.
    заведено = конфиг.get("заведено")
    if заведено:
        try:
            when = datetime.fromisoformat(заведено)
            часов = (datetime.now(when.tzinfo) - when).total_seconds() / 3600
        except Exception:
            часов = 0
        for с in живые_строки:
            if "proverka" not in с:
                continue
            лог_ = разобрать_крон(с)["лог"]
            предел_ = разобрать_крон(с)["не_старше_часов"]
            if лог_ and not os.path.exists(лог_) and часов > предел_:
                беды.append(f"проверка заведена {часов:.0f} ч назад, в расписании стоит, "
                            f"а журнала нет вовсе — не запускалась НИ РАЗУ")
    for с in сторожа:
        лог, предел = с.get("лог"), с.get("не_старше_часов", 26)
        строка = с.get("строка", "")
        имя = os.path.basename(лог or "?")

        # СТОРОЖ НЕ СТОРОЖИТ САМ СЕБЯ. Своя строка расписания попадает в список
        # наравне с прочими, но её журнал несёт не итог прогона, а СОБСТВЕННЫЙ
        # вердикт сторожа: счётчиков там нет вовсе, и строгий режим отвечал
        # «распознать не смог» — сторож краснел на самом факте своего существования.
        # Считать же его вердикт исходом нельзя тем более: получилась бы ЗАЩЁЛКА —
        # одно красное утро делает красными все последующие, потому что каждый
        # следующий прогон читает вчерашнее красное и переписывает его себе.
        if "proverka" in строка and re.search(r"\bwatch\b", строка) and корень in строка:
            continue

        if строка not in живые_строки:
            беды.append(f"строка расписания ПРОПАЛА из крона: {строка[:70]}")
            continue
        if not лог or not os.path.exists(лог):
            беды.append(f"{имя}: лога нет вовсе — значит не запускалось ни разу")
            continue
        # Смотрим на САМЫЙ СВЕЖИЙ файл в папке логов, а не на цель перенаправления.
        # Живой случай: cron.log у THE A OS пустой и датирован 05.08, потому что
        # прогон пишет в собственный файл на каждый запуск. Проверять свежесть по
        # цели перенаправления значило бы объявить мёртвым работающий прогон.
        # Смотрим только на СВОИ файлы, а не на самый свежий в папке. Если журналы
        # нескольких проектов лежат в общей папке, чужая свежесть зазеленила бы
        # проект, ничего про него не измерив.
        папка = os.path.dirname(лог) or "."
        # Основа — ПОЛНОЕ имя журнала без расширения, а не кусок до первого
        # разделителя. Иначе у «proverka-artemis-public.log» основой становится
        # «proverka», и под неё подходят журналы ВСЕХ проектов: сторож начинает
        # сторожить чужую свежесть и зеленеет, ничего про себя не измерив.
        # Поймано на себе сразу после предыдущей правки.
        основа = re.sub(r"\.[^.]*$", "", os.path.basename(лог))
        свежесть, что = os.path.getmtime(лог), os.path.basename(лог)
        try:
            for f in os.listdir(папка):
                п = os.path.join(папка, f)
                if not os.path.isfile(п):
                    continue
                свой = f.startswith(основа)
                if свой and os.path.getmtime(п) > свежесть:
                    свежесть, что = os.path.getmtime(п), f
        except Exception:
            pass
        имя = что
        возраст = (time.time() - свежесть) / 3600.0
        if возраст > предел:
            # Прежде чем кричать — спросить крон, запускал ли он эту команду.
            # Журнал, который пишется ТОЛЬКО ПРИ СБОЕ, устроен наоборот: тишина
            # в нём означает здоровье. Поймано на себе: сторож объявил мёртвым
            # пингер бота, «молчащий» 48 дней, — а крон запускал его двадцать
            # минут назад, и в журнале одни строки «бот не отвечает».
            # Ложное красное убивает систему быстрее пропущенного.
            запускался = _крон_запускал(с.get("строка", ""), предел)
            if запускался:
                порядок.append(f"{имя}: журнал молчит {возраст:.0f} ч, но крон "
                               f"запускал команду — журнал пишется только при сбое")
            else:
                беды.append(f"{имя}: молчит {возраст:.0f} ч при пределе {предел} ч, "
                            f"и крон её за это время НЕ ЗАПУСКАЛ")
        else:
            порядок.append(f"{имя}: свежий ({возраст:.1f} ч назад)")
            if строго:
                # В строгом режиме мало «прогон был» — важно, чем он кончился.
                # Выкатывать поверх известного красного = класть новое на сломанное.
                путь_свежего = os.path.join(папка, что)
                try:
                    текст = open(путь_свежего, encoding="utf-8", errors="replace").read()
                except Exception:
                    текст = ""
                счёт = посчитать(текст)
                if счёт is None:
                    беды.append(f"{имя}: чем кончился прогон — распознать не смог")
                elif счёт.get("упало"):
                    беды.append(f"{имя}: последний прогон КРАСНЫЙ "
                                f"(упало {счёт['упало']}, прошло {счёт.get('прошло', '?')})")
                elif счёт.get("всего", 0) == 0:
                    беды.append(f"{имя}: прогон был, но запущено НОЛЬ проверок")

    проект = os.path.basename(корень)
    if беды:
        текст = f"🔴 Сторож {проект}\n" + "\n".join("• " + b for b in беды)
        print(текст)
        if слать:
            print("отправлено в телеграм" if в_телеграм(текст) else "отправить не смог")
        return КРАСНО
    печать = datetime.now().strftime("%d.%m %H:%M")
    print(f"🟢 {печать} Сторож {проект}: " + "; ".join(порядок))
    return ЗЕЛЕНО


