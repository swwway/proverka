            open(os.path.join(d, "f.txt"), "w").write("x")
            subprocess.run(["git", "-C", d, "add", "-A"], capture_output=True)
            subprocess.run(["git", "-C", d, "-c", "user.email=t@t", "-c", "user.name=t",
                            "commit", "-qm", "init"], capture_output=True)
            if len(порча) > 3 and порча[3] == "экран":
                # отдаём страницу — значит браузерный сквозной обязателен
                open(os.path.join(d, "index.html"), "w").write("<html>экран</html>")
                subprocess.run(["git","-C",d,"add","-A"],capture_output=True)
                subprocess.run(["git","-C",d,"-c","user.email=t@t","-c","user.name=t",
                                "commit","-qm","экран"],capture_output=True)
            if грязнить:
                # то, что работает, лежит вне любого коммита — доказать «что именно
                # проверяли» невозможно, значит зелёным это красить нельзя
                open(os.path.join(d, "f.txt"), "w").write("правка мимо коммита")
            # У временного проекта нет ни экрана, ни клиента, ни денег — говорим
            # это прямо, иначе новое правило «обязательный вид не покрыт» честно
            # объявит честный зелёный случай непроверенным, и порча провалится
            # не по делу.
            конфиг = {"команды": {"проба": команда}, "уровень": "обычный",
                      "порчи_проверены": True, "срезы": {},
                      "деньги": {"есть": False, "когда": "самопроверка"}}
            with open(os.path.join(d, CONFIG_NAME), "w", encoding="utf-8") as f:
                if yaml:
                    yaml.safe_dump(конфиг, f, allow_unicode=True, sort_keys=False)
                else:
                    json.dump(конфиг, f, ensure_ascii=False)
            import io, contextlib
            буфер = io.StringIO()
            with contextlib.redirect_stdout(буфер):
                получили = режим_check(d)
        имена = {ЗЕЛЕНО: "зелено", КРАСНО: "красно", НЕ_ПРОВЕРЕНО: "не проверено"}
        ок = (получили == ожидали)
        провалов += 0 if ок else 1
        проб += 1
        print(f"  [{'поймал' if ок else 'ПРОВАЛ'}] {название:<38} "
              f"ждали «{имена[ожидали]}», получили «{имена[получили]}»")
    print()
    if провалов:
        print(f"ПРИБОР НЕГОДЕН: провалов {провалов} из {len(порчи)}. Верить его зелёному нельзя.")
        return КРАСНО
    # Отдельная порча на ТУРНИКЕТ: он живёт своей веткой и общей проверкой
    # не покрывается. Живой случай ERP: прошли только ворота (типы 52 с,
    # разбор кода 50 с), а наборы проверок не влезли в потолок — и турникет
    # напечатал ЗЕЛЕНО, не измерив поведение вовсе.
    with tempfile.TemporaryDirectory() as d:
        subprocess.run(["git", "init", "-q", d], capture_output=True)
        open(os.path.join(d, "f.txt"), "w").write("x")
        subprocess.run(["git", "-C", d, "add", "-A"], capture_output=True)
        subprocess.run(["git", "-C", d, "-c", "user.email=t@t", "-c", "user.name=t",
                        "commit", "-qm", "init"], capture_output=True)
        # именно КОД, а не текст: турникет тексты и настройки пропускает
        open(os.path.join(d, "rabota.py"), "w").write("def f(x):\n    return x * 2\n")
        subprocess.run(["git", "-C", d, "add", "-A"], capture_output=True)
        subprocess.run(["git", "-C", d, "-c", "user.email=t@t", "-c", "user.name=t",
                        "commit", "-qm", "работа"], capture_output=True)
        кон = {"команды": {"typecheck": 'echo "types ok"; exit 0'},
               "замеры": {"typecheck": {"секунды": 1, "проверок": None}},
               "деньги": {"есть": False, "когда": "самопроверка"}}
        with open(os.path.join(d, CONFIG_NAME), "w", encoding="utf-8") as f:
            if yaml:
                yaml.safe_dump(кон, f, allow_unicode=True, sort_keys=False)
            else:
                json.dump(кон, f, ensure_ascii=False)
        import io, contextlib
        буф = io.StringIO()
        with contextlib.redirect_stdout(буф):
            исх = режим_gate(d)
        вывод_т = буф.getvalue()

        # КОНТРОЛЬ ЗРЯЧЕСТИ ПРОБЫ. Сначала убеждаемся, что прибор ВООБЩЕ УВИДЕЛ
        # подложенное. Порча, поставленная в слепой зоне, доказывает слепоту
        # пробы, а не исправность прибора — поймано на себе: первая версия этой
        # порчи трогала файл .txt, турникет тексты пропускает, и она показала
        # зелёное, ничего не проверив. Проба обязана сначала попасть в поле
        # зрения, и только потом её вердикт что-то значит.
        видно = "рабочих 0" not in вывод_т and "только тексты" not in вывод_т
        if not видно:
            провалов += 1
            print(f"  [ПРОБА СЛЕПА] турникет не увидел подложенного — "
                  f"её вердикт ничего не доказывает")
        ок = видно and (исх == НЕ_ПРОВЕРЕНО)
        провалов += 0 if ок else 1
        проб += 1
        print(f"  [{'поймал' if ок else 'ПРОВАЛ'}] "
              f"{'турникет: прошли только ворота, поведение не измерено':<38} "
              f"ждали «не проверено», получили "
              f"«{ {0:'зелено',1:'красно',2:'не проверено'}[исх] }»")
        if провалов:
            print(f"\nПРИБОР НЕГОДЕН: провалов {провалов}. Верить его зелёному нельзя.")
            return КРАСНО

    # ─── ПОРЧА НА ЗУБЫ: МЕРЯТЬ ОДНОЙ КОМАНДОЙ ИЗ НЕСКОЛЬКИХ ──────────────────
    #
    # ЗАЧЕМ. Зубы брали из набора ПЕРВУЮ команду словаря и по ней объявляли
    # слепые пятна. Замер 15.09.2026 (red_flag): пять наборов, и порчи в
    # js/router.js, js/archive.js шли в «слепые», хотя их ловит dom-check —
    # он в том прогоне просто не запускался. Ложное слепое пятно гонит чинить
    # то, что уже проверено, и прячет настоящие дыры в общей куче. Хуже того,
    # доля менялась сама, стоило добавить в проект команду, вставшую в словарь
    # первой: число про проект, зависящее от порядка ключей.
    провалов_з = 0
    with tempfile.TemporaryDirectory() as d:
        subprocess.run(["git", "init", "-q", d], capture_output=True)
        # Боевой код с местом для порчи и команда, которая эту порчу видит.
        open(os.path.join(d, "rabota.py"), "w", encoding="utf-8").write(
            "def годен(a, b):\n    return a or b\n")
        сторож = ('grep -q "a or b" rabota.py '
                  '&& echo "ИТОГ: 1/1 проверок пройдено" '
                  '|| { echo "НЕТ строка порчена"; exit 1; }')
        кон = {"команды": {"слепая": 'echo "ИТОГ: 1/1 проверок пройдено"; exit 0',
                           "зрячая": сторож},
               # Слепая объявлена быстрой — значит в порядке прогона она первая,
               # ровно как было в живом случае.
               "замеры": {"слепая": {"секунды": 1, "проверок": 1},
                          "зрячая": {"секунды": 9, "проверок": 1}},
               "уровень": "обычный", "срезы": {},
               "деньги": {"есть": False, "когда": "самопроверка"}}
        with open(os.path.join(d, CONFIG_NAME), "w", encoding="utf-8") as f:
            if yaml:
                yaml.safe_dump(кон, f, allow_unicode=True, sort_keys=False)
            else:
                json.dump(кон, f, ensure_ascii=False)
        subprocess.run(["git", "-C", d, "add", "-A"], capture_output=True)
        subprocess.run(["git", "-C", d, "-c", "user.email=t@t", "-c", "user.name=t",
                        "commit", "-qm", "работа"], capture_output=True)
        import io as _io, contextlib
        буф_з = _io.StringIO()
        with contextlib.redirect_stdout(буф_з):
            режим_teeth(d, сколько=3)
        вывод_з = буф_з.getvalue()

        # КОНТРОЛЬ ЗРЯЧЕСТИ ПРОБЫ: если порчу класть было некуда, «поймано 0»
        # означало бы пустой прогон, а не слепоту прибора.
        подложено = re.search(r"Поймано (\d+) из (\d+)", вывод_з)
        if not подложено or int(подложено.group(2)) == 0:
            провалов_з += 1
            print("  [ПРОБА СЛЕПА] зубам некуда было класть порчу — "
                  "её вердикт ничего не доказывает")
        else:
            ок_з = int(подложено.group(1)) == int(подложено.group(2))
            провалов_з += 0 if ок_з else 1
            проб += 1
            print(f"  [{'поймал' if ок_з else 'ПРОВАЛ'}] "
                  f"{'зубы мерят весь набор, а не первую команду':<38} "
                  f"ждали «поймано всё», получили «поймано "
                  f"{подложено.group(1)} из {подложено.group(2)}»")
    провалов += провалов_з
    if провалов_з:
        print(f"\nПРИБОР НЕГОДЕН: зубы мерят не тем, чем говорят.")
        return КРАСНО

    # ─── ПОРЧА НА ДОПИСЫВАЕМЫЙ ЖУРНАЛ ────────────────────────────────────────
    #
    # ЗАЧЕМ. Сторожевые журналы дописываются (`>>`) и хранят ВСЕ прогоны.
    # `re.search` берёт первое совпадение — самый СТАРЫЙ прогон, — и прибор
    # замирает на нём навсегда. Замер 19.08.2026 (ERP): по всему
    # krug-nochnoy.log читалось {прошло 134, упало 0} (запись от 17.08), тогда
    # как последняя запись несла 551 passed / 136 failed. `watch --строго`
    # отвечал 🟢 поверх настоящего красного. Ложное зелёное — худший исход,
    # какой у прибора бывает, и общей порчей выше он НЕ ловится: там журнал
    # всегда с одним прогоном.
    провалов_ж = 0
    ЗАПИСЬ_З = "прогон A: ЗЕЛЁНЫЙ\n134 passed\n0 failed\n0 skipped\n0 flaky\n"
    ЗАПИСЬ_К = "прогон B: КРАСНЫЙ\n551 passed\n136 failed\n71 skipped\n0 flaky\n"

    # КОНТРОЛЬ ЗРЯЧЕСТИ ПРОБЫ — первым, до самой пробы. Наивное «первое
    # совпадение» на этом образце ОБЯЗАНО дать другой ответ; если оба чтения
    # совпали, образец не различает поведений и проба ничего не доказывает.
    наивное = re.search(r"^\s*(\d+)\s+failed\b", ЗАПИСЬ_З + ЗАПИСЬ_К, re.M)
    if not наивное or int(наивное.group(1)) != 0:
        провалов_ж += 1
        print("  [ПРОБА СЛЕПА] образец не различает первое и последнее "
              "совпадение — её вердикт ничего не доказывает")

    сч = посчитать(ЗАПИСЬ_З + ЗАПИСЬ_К) or {}
    ок_ж = сч.get("упало") == 136 and сч.get("прошло") == 551
    провалов_ж += 0 if ок_ж else 1
    проб += 1
    print(f"  [{'поймал' if ок_ж else 'ПРОВАЛ'}] "
          f"{'журнал дописан: последний прогон КРАСНЫЙ':<38} "
          f"ждали «упало 136», получили «упало {сч.get('упало')}»")

    # ОБРАТНАЯ ПРОБА: правка не смеет «всегда красить». Переставляем записи —
    # последней становится зелёная, и ответ обязан стать зелёным.
    сч2 = посчитать(ЗАПИСЬ_К + ЗАПИСЬ_З) or {}
    ок_ж2 = сч2.get("упало") == 0 and сч2.get("прошло") == 134
    провалов_ж += 0 if ок_ж2 else 1
    проб += 1
    print(f"  [{'поймал' if ок_ж2 else 'ПРОВАЛ'}] "
          f"{'журнал дописан: последний прогон ЗЕЛЁНЫЙ':<38} "
          f"ждали «упало 0», получили «упало {сч2.get('упало')}»")

    if провалов_ж:
        print(f"\nПРИБОР НЕГОДЕН: провалов на дописываемом журнале {провалов_ж}. "
              f"Верить его зелёному нельзя.")
        return КРАСНО

    # ─── ПОРЧА НА ЗАДАНИЕ ПО ПУСТОМУ ПРОЕКТУ ─────────────────────────────────
    #
    # ЗАЧЕМ. `zadanie` собирает работу ИЗ ЗАМЕРОВ. Там, где не заведено ни одной
    # проверки, замеров нет — и режим отвечал «нехватки не нашлось» кодом 0,
    # то есть пустота выглядела как порядок. Это тот же ноль проверок под
    # зелёным, ради которого весь прибор и написан, только в другом режиме;
    # поймано 15.09.2026 на хранилище, где проверок не было вовсе. Общими
    # порчами это не ловится: они все про режим `check`.
    провалов_з = 0
    with tempfile.TemporaryDirectory() as d:
        конфиг_п = {"команды": {}, "замеры": {}, "уровень": "обычный",
                    "деньги": {"есть": False, "когда": "самопроверка"}}
        with open(os.path.join(d, CONFIG_NAME), "w", encoding="utf-8") as f:
            if yaml:
                yaml.safe_dump(конфиг_п, f, allow_unicode=True, sort_keys=False)
            else:
                json.dump(конфиг_п, f, ensure_ascii=False)
        import io, contextlib
        буфер_з = io.StringIO()
        with contextlib.redirect_stdout(буфер_з):
            исх_з = режим_zadanie(d)
        # Файла быть не должно: задание, составленное из ничего, врёт самим
        # фактом своего существования — его прочтут как «работа известна».
        написан = os.path.exists(os.path.join(d, "ЗАДАНИЕ-ПРОВЕРКИ.md"))
        имена_з = {ЗЕЛЕНО: "зелено", КРАСНО: "красно", НЕ_ПРОВЕРЕНО: "не проверено"}
        ок_з = исх_з == НЕ_ПРОВЕРЕНО and not написан
        провалов_з += 0 if ок_з else 1
        проб += 1
        print(f"  [{'поймал' if ок_з else 'ПРОВАЛ'}] "
              f"{'задание по проекту без единой проверки':<38} "
              f"ждали «не проверено», получили «{имена_з[исх_з]}»"
              f"{' и файл задания на пустом месте' if написан else ''}")
    if провалов_з:
        print("\nПРИБОР НЕГОДЕН: по проекту без единой проверки задание уходит "
              "не тем исходом. Верить его зелёному нельзя.")
        return КРАСНО

    # ─── ПОРЧА НА УСЫХАНИЕ НАБОРА ────────────────────────────────────────────
    #
    # ЗАЧЕМ. Команды, которых разведка найти не может, добавляются вручную и
    # живут в настройках. Список ручных команд переносился из прежнего файла
    # ЦЕЛИКОМ — то есть замирал на первом значении, и добавленная сегодня
    # команда в него не попадала никогда. Следующее перезаведение брало
    # замерший список, и набор усыхал МОЛЧА: 15.09.2026 из четырёх команд
    # проекта осталось две, а справка печатала ЗЕЛЕНО по 45 проверкам вместо
    # 81. Общими порчами это не ловится: там набор всегда из одной команды.
    провалов_н = 0
    with tempfile.TemporaryDirectory() as d:
        import io, contextlib
        тихо = io.StringIO()
        with contextlib.redirect_stdout(тихо):
            режим_init(d, добавить=["первая=echo ok"])
            режим_init(d, добавить=["вторая=echo ok"])
            режим_init(d)                       # перезаведение без аргументов
        итог = прочитать_конфиг(d) or {}
        набор = set((итог.get("команды") or {}))
        ок_н = {"первая", "вторая"} <= набор
        провалов_н += 0 if ок_н else 1
        проб += 1
        print(f"  [{'поймал' if ок_н else 'ПРОВАЛ'}] "
              f"{'набор не усыхает при перезаведении':<38} "
              f"ждали «обе команды», получили «{', '.join(sorted(набор)) or 'пусто'}»")
    if провалов_н:
        print("\nПРИБОР НЕГОДЕН: при перезаведении из набора пропадают команды. "
              "Зелёное по остаткам — худший из возможных ответов.")
        return КРАСНО

    print(f"Прибор годен: поймал все порчи ({проб} из {проб}), "
          f"включая «код 0 при нуле проверок», «работающий код вне коммита» и "
          f"«дописанный журнал: судить по последнему прогону, а не по первому».")
    # Строка счётчика в том же виде, в каком прибор читает чужие самопроверки.
    # Без неё СОБСТВЕННЫЙ `check` по этому репозиторию отвечал «счётчик
    # распознать не удалось» — то есть прибор не знал, сколько проверок прогнал
    # он сам. Требовать счёт с других и не вести своего — та же дыра.
    print(f"ИТОГ: {проб}/{проб} проверок пройдено")
    return ЗЕЛЕНО


def main():
    p = argparse.ArgumentParser(prog="proverka", description="Одна команда проверки.")
    sub = p.add_subparsers(dest="режим")
    a = sub.add_parser("init", help="завести проверку в проекте")
    a.add_argument("путь", nargs="?", default=".")
    a.add_argument("--вхолостую", action="store_true", help="ничего не записывать")
    a.add_argument("--с-браузером", dest="браузер", action="store_true",
                   help="взять в набор и браузерные сценарии. Стенд должен быть поднят: "
                        "они попадут в настройки только если сейчас отработают")
    a.add_argument("--только-список", dest="только_список", action="store_true",
                   help="найти кандидатов, но ничего не запускать (для чужих проектов)")
    a.add_argument("--добавить", dest="добавить", action="append", metavar="имя=команда",
                   help="команда, которую разведка не находит (проверка на другой "
                        "машине). Запишется только если сейчас отработает")
    b = sub.add_parser("check", help="прогнать и напечатать справку")
    b.add_argument("путь", nargs="?", default=".")
    b.add_argument("--в-телеграм", dest="в_телеграм", action="store_true",
                   help="сообщить, если НЕ зелёное (на зелёном молчит)")
    sub.add_parser("selftest", help="доказать, что прибор умеет краснеть")
    t = sub.add_parser("teeth", help="зубы: подложить порчи и потребовать красного")
    t.add_argument("путь", nargs="?", default=".")
    t.add_argument("--сколько", type=int, default=12, help="сколько порч подложить")
    t.add_argument("--семя", dest="семя", type=int, default=None,
                   help="повторить конкретную выборку порч (печатается при каждом прогоне)")
    t.add_argument("--только", dest="только", default=None,
                   help="портить только файлы, чей путь содержит это")
    z = sub.add_parser("zadanie", help="составить задание на непокрытое")
    z.add_argument("путь", nargs="?", default=".")
    z.add_argument("--в-телеграм", dest="в_телеграм", action="store_true")
    g = sub.add_parser("gate", help="турникет: пускать ли отправку")
    g.add_argument("путь", nargs="?", default=".")
    g.add_argument("--потолок", dest="потолок", type=int, default=None,
                   help="сколько секунд максимум на команду (по умолчанию 60)")
    pr = sub.add_parser("profile", help="какие виды проверок обязательны проекту")
    pr.add_argument("путь", nargs="?", default=".")
    pr.add_argument("--не-нужен", dest="не_нужен", action="append", metavar="вид=причина",
                    help="объявить вид необязательным. Запишется с причиной и датой — "
                         "видно всем и навсегда, спрятать нельзя")
    pr.add_argument("--покрыто", dest="покрыто", action="append", metavar="вид=команда",
                    help="сказать, какая команда покрывает этот вид проверок")
    pr.add_argument("--деньги", dest="деньги", choices=["да", "нет"],
                    help="есть ли величина, которую складывают, переносят или должны")
    w = sub.add_parser("watch", help="сторож: не замолчала ли проверка вовсе")
    w.add_argument("путь", nargs="?", default=".")
    w.add_argument("--в-телеграм", dest="в_телеграм", action="store_true")
    w.add_argument("--строго", dest="строго", action="store_true",
                   help="мало что прогон был — он должен ещё и кончиться зелёным")
    args = p.parse_args()

    if args.режим == "init":
        # ЖЁСТКИЙ `return 0` УБРАН. Он врал: замок занят — разведка не шла, а
        # наружу уходил успех, неотличимый от сделанной работы. Своих исходов у
        # этого режима два: сделал (0) и не смог (2). Красного тут нет —
        # разведка ничего не утверждает о качестве проекта.
        итог = режим_init(args.путь, писать=not args.вхолостую,
                          запускать=not args.только_список, добавить=args.добавить,
                          браузер=args.браузер)
        return ЗЕЛЕНО if итог is not None else НЕ_ПРОВЕРЕНО
    if args.режим == "check":
        return режим_check(args.путь, слать=args.в_телеграм)
    if args.режим == "selftest":
        return режим_selftest()
    if args.режим == "teeth":
        return режим_teeth(args.путь, сколько=args.сколько, только=args.только,
                           семя=args.семя)
    if args.режим == "zadanie":
        return режим_zadanie(args.путь, слать=args.в_телеграм)
    if args.режим == "gate":
        return режим_gate(args.путь, args.потолок)
    if args.режим == "profile":
        if args.не_нужен or args.деньги or args.покрыто:
            _записать_решение(args.путь, args.не_нужен, args.деньги, args.покрыто)
        сп = режим_profile(args.путь)
        # «Не определено» — это «не знаю». На экране оно и так помечено, но
        # наружу уходило нулём, и обёртка принимала неизвестность за порядок.
        if any(not решено for _, _, решено in (сп or [])):
            return НЕ_ПРОВЕРЕНО
        return ЗЕЛЕНО
    if args.режим == "watch":
        return режим_watch(args.путь, слать=args.в_телеграм, строго=args.строго)
    p.print_help()
    return НЕ_ПРОВЕРЕНО


if __name__ == "__main__":
    sys.exit(main())
