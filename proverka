# init — обойти проект и записать ТОЛЬКО то, что реально запустилось.
# Причина существования этого режима: из четырёх команд, вписанных в замысел
# руками, две оказались нерабочими. Руками больше не пишем.
# ─────────────────────────────────────────────────────────────────────────────

def _питон_тесты(d):
    """Сколько тестовых файлов лежит. Считаем ФАЙЛЫ, а не наличие запускалки:
    иначе «pytest не установлен на хосте» читается как «тестов нет» — молчаливый
    пропуск, ровно тот класс, против которого всё написано."""
    n = 0
    for под in ("tests", "test"):
        p = os.path.join(d, под)
        if os.path.isdir(p):
            for корень_, _, файлы in os.walk(p):
                if "__pycache__" in корень_ or "node_modules" in корень_:
                    continue
                n += sum(1 for f in файлы
                         if f.startswith("test_") and f.endswith(".py")
                         or f.endswith("_test.py"))
    return n


def _службы_compose(d):
    """Работающие контейнеры этого проекта → список имён контейнеров.

    НЕ спрашиваем `docker compose ps`: он ищет проект по имени папки и на чужом
    имени возвращает ПУСТО С КОДОМ 0 — это читается как «ничего не запущено»,
    хотя контейнеры работают (живой случай: папка code/, проект ledger).
    Поэтому сверяем имена служб из yml с метками реально работающих контейнеров.
    """
    файл = next((os.path.join(d, и) for и in
                 ("docker-compose.yml", "docker-compose.yaml", "compose.yml")
                 if os.path.exists(os.path.join(d, и))), None)
    if not файл:
        return None  # compose-файла нет вовсе
    try:
        сп_служб = list((yaml.safe_load(open(файл, encoding="utf-8")) or {})
                        .get("services", {}).keys()) if yaml else []
    except Exception:
        сп_служб = []
    if not сп_служб:
        return []
    try:
        r = subprocess.run(
            ["docker", "ps", "--format",
             '{{.Names}}\t{{.Label "com.docker.compose.project"}}\t'
             '{{.Label "com.docker.compose.service"}}'],
            capture_output=True, text=True, timeout=30)
    except Exception:
        return []
    по_проектам = {}
    for строка in (r.stdout or "").splitlines():
        части = строка.split("\t")
        if len(части) != 3:
            continue
        имя, проект, служба = части
        if служба in сп_служб:
            по_проектам.setdefault(проект, []).append((служба, имя))
    if not по_проектам:
        return []
    # если совпало несколько проектов — берём тот, где сошлось больше служб
    лучший = max(по_проектам.values(), key=len)
    порядок = {с: i for i, с in enumerate(сп_служб)}
    лучший.sort(key=lambda п: порядок.get(п[0], 99))
    return [имя for _, имя in лучший]


def кандидаты(корень):
    """Список (имя, команда, почему) — что в этом проекте вообще может быть проверкой.

    Смотрим и в корень, и на уровень ниже: живой код часто лежит в
    подпапке (code/, app/, src/), и поиск только по корню даёт ложное «пусто».
    """
    сп = []
    вложенные = [корень] + [os.path.join(корень, s) for s in ("code", "app", "src", "server")
                            if os.path.isdir(os.path.join(корень, s))]

    # ── питон-тесты: считаем файлы, ищем чем запустить ──────────────────────
    for d in вложенные:
        n = _питон_тесты(d)
        if not n:
            continue
        отн = os.path.relpath(d, корень)
        метка = "pytest" if отн == "." else f"pytest:{отн}"
        рабочая = "." if отн == "." else отн
        # `which pytest` мало: ~/.local/bin не в PATH у неинтерактивных запусков,
        # и установленный pytest читался как «его нет» — молчаливый пропуск.
        # Спрашиваем сам питон, он знает про свои модули независимо от PATH.
        есть_pytest = bool(shutil.which("pytest")) or os.path.exists(
            os.path.expanduser("~/.local/bin/pytest"))
        if not есть_pytest:
            try:
                есть_pytest = subprocess.run(
                    [sys.executable, "-m", "pytest", "--version"],
                    capture_output=True, timeout=30).returncode == 0
            except Exception:
                есть_pytest = False
        if есть_pytest:
            сп.append((метка, f"cd {рабочая} && python3 -m pytest -q", f"{n} тестовых файлов"))
        else:
            службы = _службы_compose(d)
            if службы:
                контейнер = next((к for к in службы if "db" not in к), службы[0])
                сп.append((метка, f"docker exec {контейнер} pytest -q",
                           f"{n} тестовых файлов, pytest в контейнере {контейнер}"))
            else:
                сп.append((метка, None, f"{n} тестовых файлов, ЗАПУСТИТЬ НЕЧЕМ "
                                        f"(нет pytest на хосте и нет работающего контейнера)"))

    # package.json ищем и в корне, и на уровень ниже: живой код часто лежит в
    # подпапке (bot/code, service/code). Поиск только по
    # корню давал ложное «команд нет» на проектах с живыми тестами.
    for d in вложенные:
        pkg = os.path.join(d, "package.json")
        if not os.path.exists(pkg):
            continue
        try:
            данные = json.load(open(pkg, encoding="utf-8"))
            scripts = данные.get("scripts", {}) or {}
            менеджер = "pnpm" if os.path.exists(os.path.join(d, "pnpm-lock.yaml")) else "npm run"
            отн = os.path.relpath(d, корень)
            приставка = "" if отн == "." else f"cd {отн} && "
            метка_п = "" if отн == "." else f":{отн}"
            интересные = ("test", "test:unit", "test:integration", "test:e2e", "e2e",
                          "e2e:smoke", "typecheck", "check", "lint", "verify", "gate")
            for имя in интересные:
                if имя in scripts:
                    сп.append((имя + метка_п, f"{приставка}{менеджер} {имя}", "package.json"))
        except Exception:
            pass

    for отн in ("qa/nightly.sh", "scripts/gate.sh", "scripts/test.sh",
                "app/scripts/test.sh", "qa/pre-commit-guard.sh", "scripts/verify.sh"):
        путь = os.path.join(корень, отн)
        if os.path.exists(путь) and os.access(путь, os.X_OK):
            сп.append((os.path.basename(отн).replace(".sh", ""), f"bash {отн}", "скрипт в проекте"))

    return сп


def строки_крона(корень):
    """Строки крона, которые упоминают этот проект. Расписание живёт не только
    в конвейерах GitHub: ночной прогон THE A OS стоит именно в кроне, и
    поиск только по .github даёт ложное «расписания нет»."""
    try:
        r = subprocess.run(["crontab", "-l"], capture_output=True, text=True, timeout=15)
    except Exception:
        return []
    # Сопоставляем по ПОЛНОМУ пути. По имени папки нельзя: у PrivateOS папка
    # называется code, и строки крона другого проекта
    # подцеплялись к нему — семь чужих строк выдавались за свои.
    имя = os.path.basename(корень.rstrip("/"))
    общие = {"code", "app", "src", "server", "erp", "scripts", "bin"}
    # Живой код часто лежит в типовой подпапке (project/code, service/service), а
    # расписание проекта — уровнем выше (private-os/backups/backup.sh). Поэтому
    # для типового имени ищем и по родительской папке тоже.
    пути = [корень.rstrip("/")]
    if имя in общие:
        пути.append(os.path.dirname(корень.rstrip("/")))
    найдено = []
    for строка in (r.stdout or "").splitlines():
        с = строка.strip()
        if not с or с.startswith("#"):
            continue
        if any(п in с for п in пути) or (имя not in общие and имя and имя in с):
            найдено.append(с)
    # ЧУЖОЕ ОТСЕИВАЕМ ПО ПРЕДМЕТУ СТРОКИ. Совпадение по буквам слишком щедрое: путь
    # папка проекта может лежать ВНУТРИ другой папки проекта, и сторож проекта
    # сторожил заодно соседний проект — его молчание пришло бы как беда artemis, а чужая
    # свежесть могла бы сойти за свою. Если в строке есть путь в кавычках, он и есть её
    # предмет: чужой предмет — чужая строка. Строки без кавычек (скрипты резервных копий
    # вида cockpit-offsite-pull.sh) не трогаем — они называют проект только именем файла,
    # и по ним прежнее правило работает верно.
    def _родня(a, b):
        a, b = a.rstrip("/"), b.rstrip("/")
        return a == b or a.startswith(b + "/") or b.startswith(a + "/")
    мой = корень.rstrip("/")
    свои = []
    for с in найдено:
        предметы = [m.group(1) for m in re.finditer(r'"([^"]+)"', с) if m.group(1).startswith("/")]
        if предметы and not any(_родня(п, мой) for п in предметы):
            continue
        свои.append(с)
    return свои


def разобрать_крон(строка):
    """Из строки крона достаём: куда она пишет лог и как часто должна срабатывать.

    Нужно для сторожа: если ожидаемый лог перестал обновляться, значит проверка
    НЕ ЗАПУСКАЛАСЬ — а это тишина, и тишина читается как «всё хорошо».
    Именно так замолчал журнал безопасного слива 12.08, и никто не
    заметил двое суток, пока проходило сорок вливаний.
    """
    # путь может быть в кавычках И содержать пробелы (THE A Holding/THE A OS)
    m = re.search(r">>?\s*\"([^\"]+\.log)\"", строка) or \
        re.search(r">>?\s*(\S+\.log)", строка)
    лог = m.group(1) if m else None
    поля = строка.split()
    часов = 26  # по умолчанию считаем суточным
    если_понял = False
    if len(поля) >= 5:
        мин, час, день, мес,днед = поля[:5]
        if день == "*" and мес == "*" and днед == "*":
            if час.isdigit():
                часов, если_понял = 26, True
            else:
                м = re.match(r"\*/(\d+)$", час)
                if м:
                    часов, если_понял = int(м.group(1)) + 2, True
                elif час == "*":
                    м2 = re.match(r"\*/(\d+)$", мин)
                    часов, если_понял = ((int(м2.group(1)) // 60) + 2 if м2 else 2), True
    return dict(лог=лог, не_старше_часов=часов, расписание_разобрано=если_понял)


def живое_расписание(корень):
    """Конвейеры с НЕзакомментированным cron. Закомментированное — не расписание."""
    d = os.path.join(корень, ".github", "workflows")
    живые = []
    if not os.path.isdir(d):
        return живые
    for f in sorted(os.listdir(d)):
        if not f.endswith((".yml", ".yaml")):
            continue
        try:
            txt = open(os.path.join(d, f), encoding="utf-8", errors="replace").read()
        except Exception:
            continue
        if re.search(r"^\s*-\s*cron:", txt, re.M):
            живые.append(f)
    return живые


# Команды, которые разведке НЕЛЬЗЯ палить: они трогают живое — выкатывают,
