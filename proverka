# ─────────────────────────────────────────────────────────────────────────────

def _int(m, idx=1):
    try:
        return int(m.group(idx))
    except Exception:
        return None


def _посл(шаблон, текст, флаги=0):
    """ПОСЛЕДНЕЕ совпадение шаблона, а не первое.

    ⚠️ ЗАЧЕМ ЭТО ЕСТЬ (замер 19.08.2026 на боевом проекте, слой 2). Сторожевые журналы
    ДОПИСЫВАЮТСЯ (`>>`), и в них лежит не один прогон, а все. `re.search`
    берёт ПЕРВОЕ совпадение — то есть самый СТАРЫЙ прогон, и с ростом журнала
    прибор замирает на нём навсегда.

    Как это выглядело: `посчитать` по всему ~/logs/krug-nochnoy.log
    отдавала {прошло:134, упало:0} — счётчики записи от 17.08, — тогда как
    последняя запись (18.08, прогон 32102861232) несла 551 passed / 136 failed.
    `proverka watch --строго` на этом журнале отвечал 🟢. Ложное ЗЕЛЁНОЕ поверх
    настоящего красного — то есть прибор врал успехом.

    Правило уже было выведено в этом же файле 16.08 для ветки `свои_счётчики`
    (`findall(...)[-1]`), но осталось в одной ветке из восьми. Здесь оно
    распространено на все: починен класс, а не случай.
    """
    m = None
    for m in re.finditer(шаблон, текст, флаги):
        pass
    return m


def посчитать(текст):
    """-> dict(прошло, упало, пропущено, мигнуло, всего) либо None если не разобрали.

    ⚠️ СНАЧАЛА СНИМАЕМ ЦВЕТ, И ЭТО НЕ КОСМЕТИКА (замер 14.08.2026 на боевом проекте).
    Vitest красит сводку даже в трубу, и между числом и словом встают escape-коды:
        `Tests \x1b[22m \x1b[1m\x1b[32m6935 passed\x1b[39m … (6938)`
    Ни один шаблон ниже по такой строке не срабатывает — разведка ERP так и
    записала «код 0, 472 с, счётчик не распознан». А «счётчика нет» у прибора
    означает НЕ ПРОВЕРЕНО: полный зелёный ярус из 6935 проверок читался бы как
    «не знаю». Проверено обеими сторонами на настоящем выводе: как есть → None,
    без кодов → 6935 прошло / 3 пропущено / 6938 всего.
    """
    t = re.sub(r"\x1b\[[0-9;]*[A-Za-z]", "", текст or "")

    # Vitest / Jest:  "Tests  123 passed | 4 skipped (127)"
    m = _посл(r"Tests\s+(?:(\d+)\s+failed[ ,|]+)?(\d+)\s+passed(?:[ ,|]+(\d+)\s+skipped)?\s*\((\d+)\)", t)
    if m:
        return dict(упало=int(m.group(1) or 0), прошло=int(m.group(2)),
                    пропущено=int(m.group(3) or 0), мигнуло=0, всего=int(m.group(4)))

    # Vitest, когда вообще не нашёл файлов
    if re.search(r"No test files found|no tests? found", t, re.I):
        return dict(прошло=0, упало=0, пропущено=0, мигнуло=0, всего=0)

    # Playwright: строки "91 passed (13.3m)", "1 failed", "5 skipped", "2 flaky"
    pw = {}
    for ключ, слово in (("прошло", "passed"), ("упало", "failed"),
                        ("пропущено", "skipped"), ("мигнуло", "flaky")):
        mm = _посл(r"^\s*(\d+)\s+" + слово + r"\b", t, re.M)
        if mm:
            pw[ключ] = int(mm.group(1))
    if pw:
        pw.setdefault("прошло", 0); pw.setdefault("упало", 0)
        pw.setdefault("пропущено", 0); pw.setdefault("мигнуло", 0)
        pw["всего"] = pw["прошло"] + pw["упало"] + pw["пропущено"] + pw["мигнуло"]
        return pw

    # node --test / TAP: строки "# tests 879", "# pass 879", "# fail 0", "# skipped 0"
    if re.search(r"^#\s+(tests|pass)\s+\d+", t, re.M):
        def tap(слово):
            mm = re.findall(r"^#\s+" + слово + r"\s+(\d+)", t, re.M)
            return int(mm[-1]) if mm else 0
        всего = tap("tests") or (tap("pass") + tap("fail") + tap("skipped"))
        return dict(прошло=tap("pass"), упало=tap("fail"),
                    пропущено=tap("skipped"), мигнуло=0, всего=всего)

    # pytest: "=== 5 passed, 2 skipped, 1 failed in 1.23s ==="
    if re.search(r"=+\s.*\b(passed|failed|no tests ran)\b.*=+", t):
        res = dict(прошло=0, упало=0, пропущено=0, мигнуло=0)
        for ключ, слово in (("прошло", "passed"), ("упало", "failed"),
                            ("пропущено", "skipped"), ("мигнуло", "xfailed")):
            mm = _посл(r"(\d+)\s+" + слово + r"\b", t)
            if mm:
                res[ключ] = int(mm.group(1))
        if re.search(r"no tests ran", t, re.I):
            res = dict(прошло=0, упало=0, пропущено=0, мигнуло=0)
        res["всего"] = sum(res.values())
        return res

    # Своя самопроверка проекта: "ИТОГ: 12/12 проверок пройдено".
    # Важно: она возвращает код 0 ДАЖЕ при 2/12 — по коду возврата её судить
    # нельзя, только по этой строке. Ровно «прибор отчитался успехом, не сделав дела».
    m = _посл(r"ИТОГ:\s*(\d+)\s*/\s*(\d+)\s*провер", t)
    if m:
        прошло_, всего_ = int(m.group(1)), int(m.group(2))
        return dict(прошло=прошло_, упало=всего_ - прошло_, пропущено=0,
                    мигнуло=0, всего=всего_)

    # Свой ночной прогон THE A OS: "=== SMOKE=0 E2E=0 PHONE=1 ==="
    m = _посл(r"===\s*SMOKE=(\d+)\s+E2E=(\d+)\s+PHONE=(\d+)\s*===", t)
    if m:
        упало = int(m.group(1)) + int(m.group(2)) + int(m.group(3))
        прошло_m = _посл(r"(\d+)\s+passed", t)
        прошло = int(прошло_m.group(1)) if прошло_m else 0
        return dict(прошло=прошло, упало=упало, пропущено=0, мигнуло=0,
                    всего=прошло + упало)

    # Свой же `proverka check`: журнал ночной проверки несёт не сырой вывод
    # прогонщика, а СОБСТВЕННУЮ таблицу прибора. Строгий сторож читал именно её
    # и отвечал «чем кончился прогон — распознать не смог» — то есть зелёный
    # ярус из 8231 проверки читался как «не знаю», и сторож краснел на исправном
    # проекте (замер 16.08.2026 на боевом проекте: обе строки расписания в сторожах, обе
    # красные, при упало=0).
    # Берём ПОСЛЕДНЕЕ вхождение: журнал ДОПИСЫВАЕТСЯ каждую ночь, и первое
    # вхождение — самый старый прогон; судить по нему значит судить о позавчера.
    свои_счётчики = re.findall(
        r"СЧЁТЧИКИ\s+найдено\s+(\d+)\s*·\s*прошло\s+(\d+)\s*·\s*упало\s+(\d+)"
        r"\s*·\s*пропущено\s+(\d+)", t)
    if свои_счётчики:
        всего_, прошло_, упало_, пропущено_ = (int(x) for x in свои_счётчики[-1])
        return dict(прошло=прошло_, упало=упало_, пропущено=пропущено_,
                    мигнуло=0, всего=всего_)

    return None  # честное «не знаю»


