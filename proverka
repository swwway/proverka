ПОДСКАЗКИ_ВИДОВ = {
    "браузерный сквозной": ("e2e", "playwright", "cypress", "браузер"),
    "сквозной через чужой клиент": ("телеграм", "клиент", "бот",
                                    "самопроверка", "audit"),
    "разбор типов": ("typecheck", "types", "tsc"),
    "эталоны": ("эталон", "оракул"),
    "инварианты на копии базы": ("инвариант", "схем", "parity"),
}

# Виды, которым подсказки не нужны ОСОЗНАННО, а не по забывчивости. Список нужен,
# чтобы самопроверка могла отличить «подсказок нет намеренно» от «ключ разъехался».
БЕЗ_ПОДСКАЗОК = {
    "проверки поведения",              # покрыты самим фактом счётчиков
    "телеграм — канал уведомлений, не рабочее место",  # это пояснение, не требование
}


def _сверить_ключи_видов():
    """Совпадают ли ключи подсказок с тем, что на самом деле выдаёт определитель.

    Возвращает список расхождений. Пусто — значит каждый обязательный вид либо
    имеет подсказки, либо освобождён от них явно.
    """
    образцы = [
        {"типы": (True, ""), "свой_экран": (True, ""), "чужой_клиент": (True, ""),
         "база": (True, "")},
        {"типы": (False, ""), "свой_экран": (False, ""), "чужой_клиент": (True, ""),
         "база": (False, "")},
    ]
    беда = []
    for св in образцы:
        for деньги in (True, False, None):
            for вид, _, _ in виды_проверок(св, деньги):
                ключ = вид.split(":")[0].strip()
                if ключ in ПОДСКАЗКИ_ВИДОВ or ключ in БЕЗ_ПОДСКАЗОК:
                    continue
                if вид not in беда:
                    беда.append(вид)
    return беда


def _записать_решение(корень, не_нужен=None, деньги=None, покрыто=None):
    """Решения хозяина о видах — в настройки, с причиной и датой.

    Обойти требование можно, спрятать — нельзя: запись видна в файле проекта
    и печатается в каждой справке. Это та же черта, что у SKIP_GATE в выкатке:
    разница между «нельзя» и «нельзя тайком».
    """
    корень = os.path.abspath(корень)
    путь = os.path.join(корень, CONFIG_NAME)
    конфиг = прочитать_конфиг(корень) or {}
    когда = datetime.now(timezone.utc).astimezone().isoformat(timespec="seconds")
    if не_нужен:
        п = конфиг.setdefault("перебито_видами", {})
        for пара in не_нужен:
            вид, _, причина = пара.partition("=")
            п[вид.strip()] = f"{причина.strip() or 'без причины'} ({когда[:10]})"
            print(f"  записано: «{вид.strip()}» объявлен необязательным — "
                  f"{причина.strip() or 'причина не названа'}")
    if покрыто:
        п = конфиг.setdefault("виды_покрыты", {})
        команды_ = конфиг.get("команды") or {}
        for пара in покрыто:
            вид, _, ком = пара.partition("=")
            вид, ком = вид.strip(), ком.strip()
            if ком not in команды_:
                print(f"  ⚠ «{ком}» нет среди команд проекта — не записываю")
                continue
            п[вид] = ком
            print(f"  записано: «{вид}» покрывает команда «{ком}»")
    if деньги:
        конфиг["деньги"] = {"есть": деньги == "да", "когда": когда,
                            "мера_на_тот_день": мера_денег(корень)}
        print(f"  записано: деньги — {деньги}")
    with open(путь, "w", encoding="utf-8") as f:
        if yaml:
            yaml.safe_dump(конфиг, f, allow_unicode=True, sort_keys=False)
        else:
            json.dump(конфиг, f, ensure_ascii=False, indent=2)


def режим_profile(корень, печатать=True):
    корень = os.path.abspath(корень)
    конфиг = прочитать_конфиг(корень) or {}
    деньги = (конфиг.get("деньги") or {}).get("есть") if isinstance(
        конфиг.get("деньги"), dict) else None
    св = определить(корень)
    сп = виды_проверок(св, деньги)

    перебито = конфиг.get("перебито_видами") or {}
    if печатать:
        print(f"Что обязательно проверять: {os.path.basename(корень)}\n")
        for вид, улика, решено in сп:
            ключ = вид.split(":")[0].strip()
            if ключ in перебито:
                print(f"  ⤷ {вид:<32} ПЕРЕБИТО ВРУЧНУЮ: {перебито[ключ]}")
                continue
            метка = "  " if решено else "⚠ "
            print(f"  {метка}{вид:<32} ← {улика}")
        if перебито:
            print("\n  Перебито вручную — видно и не спрятано:")
            for к, v in перебито.items():
                print(f"    {к}: {v}")
        не_решено = [в for в, _, р in сп if not р]
        if не_решено:
            print(f"\n  ⚠ Не определено: {len(не_решено)}. Это «не знаю», а не «не нужно».")
    return сп


def режим_init(корень, писать=True, запускать=True, добавить=None, браузер=False):
    корень = os.path.abspath(корень)
    with Замок(корень) as з:
        if not з.взят:
            print("По этому проекту уже идёт прогон — разведка подождёт, "
                  "иначе оба испортят друг другу тестовую базу.")
            # None, а не {}: наверху это переводится в НЕ ПРОВЕРЕНО. Пустой
            # словарь неотличим от «разведка отработала и ничего не нашла»,
            # а это разные вещи — и внешний скрипт принимал занятый замок
            # за успешную переинициализацию.
            return None
        return _init_внутри(корень, писать, запускать, добавить, браузер)


def _init_внутри(корень, писать=True, запускать=True, добавить=None, браузер=False):
    print(f"Завожу проверку: {корень}\n")

    сп = кандидаты(корень)
    # Команда, которую разведка найти не может: проверка живёт на другой машине,
    # зовётся по сети или требует своего окружения. Правило то же — она попадёт
    # в настройки ТОЛЬКО если сейчас запустится и вернёт код возврата.
    if добавить:
        for пара in добавить:
            если_имя, _, если_ком = пара.partition("=")
            if если_имя and если_ком:
                сп.append((если_имя.strip(), если_ком.strip(), "добавлена вручную"))
    # Ранее добавленные вручную — тоже, иначе перезаведение их стирает. Живой
    # случай: у XE.BOT единственная проверка это самопроверка по сети, разведка
    # найти её не может, и после init проект остался вообще без проверок.
    _прежний = прочитать_конфиг(корень) or {}
    _ручные = _прежний.get("добавлены_вручную") or {}
    _уже = {и for и, _, _ in сп}
    for _и, _к in _ручные.items():
        if _и not in _уже:
            сп.append((_и, _к, "добавлена вручную"))
    if not сп:
        print("  Кандидатов не найдено: ни package.json со скриптами, ни qa/*.sh, ни питон-тестов.")
    else:
        print(f"  Кандидатов найдено: {len(сп)}. Пробую запустить каждого "
              f"(потолок {INIT_TIMEOUT} с).\n")

    рабочие, долгие, мёртвые, не_палил = [], [], [], []
    for имя, команда, откуда in сп:
        print(f"    · {имя:<18} {команда or '—'}", end="", flush=True)
        if команда is None:
            # тесты есть, а запускалки нет. Это НЕ «тестов нет» — это дыра,
            # и она обязана быть записана, а не проглочена молчанием.
            print(f"   → {откуда}")
            мёртвые.append(dict(имя=имя, команда="—", причина=откуда))
            continue
        if not запускать:
            print("   → найдена, но не запускал (режим только-список)")
            не_палил.append(dict(имя=имя, команда=команда, причина="режим только-список"))
            continue
        своя = откуда == "добавлена вручную"
        браузерная = БРАУЗЕРНЫЕ.search(имя) or БРАУЗЕРНЫЕ.search(команда)
        if ОСТОРОЖНЫЕ.search(имя) or ОСТОРОЖНЫЕ.search(команда):
            if not своя and not (браузерная and браузер):
                # Разведка не палит по живому стенду — но и не молчит про находку.
                # Браузерные сценарии — единственное, что ловит «кнопка не нажалась»
                # и «правка существующей записи»; если их только упомянуть и не
                # записать, они не будут гоняться никогда. Поэтому говорим прямо,
                # что делать: `proverka init --с-браузером` один раз при поднятом стенде.
                if браузерная:
                    print("   → НАЙДЕНА, но в набор НЕ ВЗЯТА: нужен поднятый стенд.\n"
                          f"{'':>26}Возьми так: proverka init <проект> --с-браузером")
                    не_палил.append(dict(имя=имя, команда=команда,
                                         причина="браузерная: нужен поднятый стенд, "
                                                 "взять через --с-браузером"))
                else:
                    print("   → найдена, НЕ ЗАПУСКАЛ намеренно (трогает живое)")
                    не_палил.append(dict(имя=имя, команда=команда, причина="трогает живое"))
                continue
        # Найденной кандидатке даём короткий потолок — разведка не должна висеть.
        # Добавленной вручную даём полный: её позвали намеренно, и длинный набор
        # (у PrivateOS это 1063 проверки за 29 минут) — не повод объявлять её долгой.
        r = запустить(команда, корень, CHECK_TIMEOUT if своя else INIT_TIMEOUT)
        счёт = посчитать(r["вывод"])
        if r["оборвалось"]:
            print(f"   → долгая (>{INIT_TIMEOUT} с)")
            долгие.append(dict(имя=имя, команда=команда, откуда=откуда))
        elif r["код"] is None:
            print(f"   → НЕ ЗАПУСТИЛАСЬ ({r['ошибка']})")
            мёртвые.append(dict(имя=имя, команда=команда, причина=r["ошибка"]))
        elif r["код"] == 127 or re.search(r"command not found|no such file", r["вывод"] or "", re.I):
            print("   → НЕ ЗАПУСТИЛАСЬ (нет такой команды)")
            мёртвые.append(dict(имя=имя, команда=команда, причина="нет такой команды"))
        else:
            найдено = счёт["всего"] if счёт else None
            хвост = f"код {r['код']}, {r['секунды']} с"
            хвост += f", проверок {найдено}" if найдено is not None else ", счётчик не распознан"
            print(f"   → работает ({хвост})")
            рабочие.append(dict(имя=имя, команда=команда, откуда=откуда,
                                секунды=r["секунды"], код_на_разведке=r["код"],
                                проверок_на_разведке=найдено))

    расписание = живое_расписание(корень)
    крон = строки_крона(корень)
    ид = опознать(корень)

    конфиг = {
        "заведено": datetime.now(timezone.utc).astimezone().isoformat(timespec="seconds"),
        "правило": "Здесь только то, что скрипт САМ запустил и увидел код возврата. Руками не дописывать.",
        "команды": {r["имя"]: r["команда"] for r in рабочие},
        "замеры": {r["имя"]: {"секунды": r["секунды"],
                              "проверок": r["проверок_на_разведке"]} for r in рабочие},
        "долгие_не_в_быстром_наборе": {r["имя"]: r["команда"] for r in долгие},
        "не_запустились": {r["имя"]: r["причина"] for r in мёртвые},
        "найдены_но_не_запускал": {r["имя"]: r["причина"] for r in не_палил},
        "добавлены_вручную": {r["имя"]: r["команда"] for r in рабочие
                              if r.get("откуда") == "добавлена вручную"},
        "конвейеры_с_живым_расписанием": расписание,
        "строки_крона": крон,
        # Свою строку берём в сторожа НЕ СРАЗУ, а как только её журнал появится.
        #
        # Раньше она исключалась навсегда — чтобы сторож не кричал «не запускалось
        # ни разу» на первом же прогоне. Но следствие оказалось хуже причины: у
        # только что заведённого проекта СВОЯ строка — единственная, и сторож
        # оставался пуст НАВСЕГДА. То есть у самой ночной проверки не было сторожа
        # тишины — а её тишина и опаснее всего: перестала запускаться, и никто не
        # узнал, потому что отсутствие сообщения замечается хуже всего.
        # Замер: из пяти заведённых проектов сторож был у одного, и то случайно —
        # у бота были свои строки крона ещё до прибора.
        #
        # Теперь: журнал есть — строка сторожится; журнала нет — не сторожится, но
        # это отдельно проверяется в самом стороже (см. «заведена и не запускалась»).
        "сторож": [dict(строка=с, **разобрать_крон(с)) for с in крон
                   if разобрать_крон(с)["лог"]
                   and ("proverka" not in с
                        or os.path.exists(разобрать_крон(с)["лог"]))],
        "опознавание_работающего": ид,
        "уровень": "обычный",
        "срезы": {},
    }

    print("\n  Итог разведки:")
    print(f"    работают:        {len(рабочие)}")
    print(f"    долгие:          {len(долгие)}   (в быстрый набор не идут)")
    print(f"    не запустились:  {len(мёртвые)}")
    print(f"    не палил:        {len(не_палил)}  (трогают живое или режим только-список)")
    print(f"    конвейеров с живым расписанием: {len(расписание)}")
    print(f"    строк в кроне:   {len(крон)}")
    for с in крон[:3]:
        print(f"                     {с[:96]}")
    if ид.get("коммит"):
        чисто = "всё в коммите" if ид.get("всё_в_коммите") else \
                f"⚠ {ид.get('грязных_файлов')} файлов вне коммита — работает не то, что в git"
        print(f"    опознавание:     {ид['коммит']} · {чисто}")
    else:
        print("    опознавание:     ⚠ не git-репозиторий, опознать работающую версию нечем")

    # Решения владельца ПЕРЕЖИВАЮТ перезаведение. Разведка пересобирает команды и
    # замеры — она не имеет права стирать ответ про деньги, перебитые виды и
    # замер зубами. Поймано на PrivateOS: ответ «деньги есть» исчез при повторном
    # init, и задание тут же снова спросило то, что уже спрошено.
    прежний = прочитать_конфиг(корень) or {}
    for ключ in ("деньги", "перебито_видами", "виды_покрыты", "порчи_проверены",
                 "срезы", "уровень", "добавлены_вручную"):
        if ключ in прежний and прежний[ключ] not in (None, {}, ""):
            конфиг[ключ] = прежний[ключ]

    # ...НО РУЧНЫЕ КОМАНДЫ СЛИВАЮТСЯ, А НЕ ЗАМЕЩАЮТСЯ ЦЕЛИКОМ.
    #
    # Слепое «взять прежнее» выше защищает от потери, а здесь оно её и
    # устраивало: список ручных команд замирал на первом значении, и
    # добавленная сегодня команда в него не попадала НИКОГДА. Следующее
    # перезаведение без аргументов брало этот замерший список — и набор
    # молча усыхал. Замер 15.09.2026: из четырёх команд проекта в наборе
    # осталось две, а справка по-прежнему печатала ЗЕЛЕНО — по 45
    # проверкам вместо 81. Это ровно то, ради чего прибор написан:
    # проверок стало вдвое меньше, а выглядит как «всё хорошо».
    #
    # Новое имеет приоритет: команду могли исправить, и исправленная
    # версия только что отработала.
    if прежний.get("добавлены_вручную"):
        конфиг["добавлены_вручную"] = {**прежний["добавлены_вручную"],
                                       **{r["имя"]: r["команда"] for r in рабочие
                                          if r.get("откуда") == "добавлена вручную"}}

    if писать:
        путь = os.path.join(корень, CONFIG_NAME)
        if yaml:
            with open(путь, "w", encoding="utf-8") as f:
                yaml.safe_dump(конфиг, f, allow_unicode=True, sort_keys=False)
        else:
            with open(путь, "w", encoding="utf-8") as f:
                json.dump(конфиг, f, ensure_ascii=False, indent=2)
        print(f"\n  Записано: {путь}")
    return конфиг


