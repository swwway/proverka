def _питон_по_шебангу(путь):
    """Файл без расширения — это питон-скрипт? Судим по первой строке.

    Исполняемый CLI без расширения — норма (сам этот прибор так и лежит), но по
    расширению он невидим. Замер 15.09.2026: зубы по собственному репозиторию
    отвечали «мест для порчи не нашлось» — то есть прибор не мог измерить СЕБЯ
    тем же способом, каким мерит других, и строка «умеет краснеть» оставалась
    недоказанной навсегда.
    """
    try:
        with open(путь, "rb") as f:
            первая = f.readline(200)
    except Exception:
        return False
    return первая.startswith(b"#!") and b"python" in первая


def _цели_порчи(корень, предел=4000):
    """Файлы боевого кода (не тесты) и места, куда можно подложить порчу.

    Два правила, купленные ошибками первых прогонов:
    · собираем со ВСЕХ файлов, а не до первого предела — иначе обход обрывается
      на алфавите и до файла с тестами дело не доходит вовсе;
    · пропускаем текст пояснений (строки в тройных кавычках). Порча в описании —
      это порча в прозе: тесты на неё не реагируют по построению, и она врёт
      в счёт слепых пятен.
    """
    цели = []
    for путь_корня, папки, файлы in os.walk(корень):
        папки[:] = [d for d in папки if d not in
                    ("__pycache__", "node_modules", ".git", "tests", "test",
                     "venv", ".venv", "logs", "backups", "dist", "build",
                     "__tests__", ".next", "coverage")]
        for ф in sorted(файлы):
            питон = ф.endswith(".py") and not ф.startswith("test_")
            тайп = (ф.endswith((".ts", ".js", ".mjs", ".cjs"))
                    and not ф.endswith((".d.ts", ".test.ts", ".test.js",
                                        ".spec.ts", ".spec.js")))
            if not (питон or тайп) and "." not in ф:
                питон = _питон_по_шебангу(os.path.join(путь_корня, ф))
            if not (питон or тайп):
                continue
            набор = ПОРЧИ_PY if питон else ПОРЧИ_TS
            п = os.path.join(путь_корня, ф)
            try:
                строки = open(п, encoding="utf-8", errors="replace").read().splitlines()
            except Exception:
                continue
            в_описании = None  # какой кавычкой открыто пояснение
            for н, строка in enumerate(строки):
                гол = строка.strip()
                # состояние «мы внутри тройных кавычек» ведём по всему файлу
                if в_описании:
                    if в_описании in строка:
                        в_описании = None
                    continue
                for кав in ('"""', "'''"):
                    if кав in гол:
                        # открылось и закрылось на одной строке — это не блок
                        if гол.count(кав) % 2 == 1:
                            в_описании = кав
                        break
                if в_описании or not гол or гол.startswith(("#", "//", "*", "/*")):
                    continue
                for что, на, описание in набор:
                    if что in строка:
                        цели.append(dict(файл=п, строка_н=н, было=строка,
                                         стало=строка.replace(что, на, 1),
                                         описание=описание))
                        break
                if len(цели) >= предел:
                    return цели
    return цели


def режим_teeth(корень, сколько=12, только=None, семя=None):
    # Замок берём по ИСХОДНОМУ проекту, а не по копии: зубы гоняют тот же набор,
    # и он ходит в ту же временную базу. Без этого зубы и обычная проверка дерутся
    # и дают выдуманное красное — поймано на кокпите.
    with Замок(корень) as з:
        if not з.взят:
            print("По этому проекту уже идёт прогон — зубы подождут.")
            return НЕ_ПРОВЕРЕНО
        return _teeth_внутри(корень, сколько, только, семя)


def _teeth_внутри(корень, сколько=12, только=None, семя=None):
    import shutil as sh, tempfile, random
    корень = os.path.abspath(корень)
    конфиг = прочитать_конфиг(корень)
    if not конфиг or not (конфиг.get("команды") or {}):
        print("Сначала заведи проверку: proverka init")
        return НЕ_ПРОВЕРЕНО
    команды = конфиг["команды"]
    # Берём НАБОР проверок, а не ворота: порча должна ронять поведение, а
    # проверка типов на вывернутое сравнение и не обязана реагировать.
    ворота = ("typecheck", "lint", "guard", "build")
    наборные = {к: v for к, v in команды.items()
                if not any(в in к.lower() for в in ворота)}
    # ВЕСЬ набор, а не первая команда из словаря. Замер 15.09 (red_flag): в
    # проекте пять наборов, зубы брали `next(iter(...))` — и порчи в js/router.js
    # и js/archive.js объявлялись слепыми пятнами, хотя их ловит dom-check,
    # который в этом прогоне просто не запускали. Хуже: стоило добавить в
    # проект команду, вставшую в словарь первой, и доля пойманного менялась
    # сама собой, ничего не говоря о проекте. Слепое пятно — это место, на
    # котором промолчал ВЕСЬ набор.
    замеры = конфиг.get("замеры") or {}
    порядок = sorted((наборные or команды).items(),
                     key=lambda п: (замеры.get(п[0]) or {}).get("секунды") or 1e9)
    имена_набора = [и for и, _ in порядок]

    print(f"Зубы: подкладываю порчи в боевой код и требую, чтобы покраснел "
          f"хоть один из набора: {', '.join(имена_набора)}.")
    print("Порядок — от самой быстрой команды к самой долгой: дешёвый ловец "
          "обрывает прогон,\nа полную цену платят только слепые пятна.")
    print("Работаю на копии — живой код не трогается.\n")

    with tempfile.TemporaryDirectory() as врем:
        копия = os.path.join(врем, "копия")
        # ⚠️ ИСКЛЮЧЕНИЯ — НЕ АККУРАТНОСТЬ, А УСЛОВИЕ ИСПОЛНИМОСТИ (замер 14.08, ERP).
        # Кроме `node_modules` копию раздувают сборка `.next`, каталоги улик
        # `audit_*`/`audit_evidence`, отчёты прогонов `test-results`,
        # `playwright-report` и `coverage`. На ERP это сотни мегабайт и десятки
        # тысяч файлов, к предмету порчи отношения не имеющих: порча кладётся
        # в ИСХОДНИК, а не в артефакты.
        sh.copytree(корень, копия, symlinks=True,
                    ignore=sh.ignore_patterns("node_modules", ".git", "__pycache__",
                                              "*.log", "logs", "backups",
                                              ".next", "audit_*", "audit_evidence",
                                              "test-results", "playwright-report",
                                              "coverage", ".turbo", "dist", "build"))
        # node_modules не копируем (десятки тысяч файлов), но БЕЗ них в копии не
        # запускается ни одна node-команда — код 127, и зубы меряют пустоту.
        # Поэтому подставляем ссылкой на настоящие.
        for путь_корня, папки, _ in os.walk(корень):
            if "node_modules" in папки:
                относ = os.path.relpath(путь_корня, корень)
                цель = os.path.join(копия, относ, "node_modules")
                if not os.path.exists(цель):
                    os.makedirs(os.path.dirname(цель), exist_ok=True)
                    os.symlink(os.path.join(путь_корня, "node_modules"), цель)
                папки.remove("node_modules")
            for скип in (".git", "__pycache__", ".venv", "venv"):
                if скип in папки:
                    папки.remove(скип)
        # 1. без порчи КАЖДАЯ команда набора обязана быть ЗЕЛЁНОЙ, иначе
        #    мерить нечем: красная команда красна на любой порче и выдаёт
        #    чужое красное за пойманное.
        всего_база = 0
        for имя_к, команда in порядок:
            осн = запустить(команда, копия, 600)
            if осн["код"] != 0:
                print(f"Прогон без порчи уже красный (код {осн['код']}). "
                      f"Сначала почини его — на красном зубы не меряются.\n"
                      f"  команда: {команда}\n  папка:   {копия}\n  хвост вывода:")
                for строка in (осн["вывод"] or "").splitlines()[-15:]:
                    print(f"    {строка}")
                return КРАСНО
            штук = (посчитать(осн["вывод"]) or {}).get("всего")
            всего_база += штук or 0
            print(f"  без порчи: {имя_к} зелено, проверок {штук if штук is not None else '?'}")
        print(f"  итого в наборе проверок: {всего_база}\n")

        цели = _цели_порчи(копия)
        if только:
            цели = [ц for ц in цели if только in ц["файл"]]
            print(f"  прицел: только {только} — мест {len(цели)}\n")
        if not цели:
            print("Мест для порчи не нашлось — проверять нечего.")
            return НЕ_ПРОВЕРЕНО
        # Раскладываем порчи ПО КРУГУ между файлами. Если брать подряд, все порчи
        # уходят в первый попавшийся файл, и про остальные мы не узнаём ничего —
        # первый прогон так и вышел: восемь порч в один файл, до нужного не дошло.
        по_файлам = {}
        for ц in цели:
            по_файлам.setdefault(ц["файл"], []).append(ц)
        for сп in по_файлам.values():  # внутри файла — из разных мест
            видно, оставить = set(), []
            for ц in сп:
                if ц["строка_н"] // 25 in видно:
                    continue
                видно.add(ц["строка_н"] // 25)
                оставить.append(ц)
            сп[:] = оставить
        # Порчи берутся ВРАЗНОБОЙ, а не первые по порядку.
        #
        # Предсказуемый набор выучивается: получив «порча в alerts.ts:79 не поймана»,
        # можно написать проверку ровно на эту строку — замер станет 10 из 10, не
        # поймав ничего настоящего. Измеримая цель порождает подгонку под измерение.
        # Со случайной выборкой подогнать нельзя: чтобы ловить любую порчу, надо
        # покрыть код по-настоящему.
        #
        # Семя печатается и записывается — значит КОНКРЕТНЫЙ замер воспроизводим
        # (`--семя <число>`), а следующий будет другим.
        если_семя = семя if семя is not None else random.randrange(1, 10 ** 6)
        бросок = random.Random(если_семя)
        print(f"  семя выборки: {если_семя}  (повторить: --семя {если_семя})")

        # Ни один каталог не забирает больше половины выборки: у ERP четыре тысячи
        # мест, и почти все в scripts/ — без этого порчи мерили бы сборочные
        # скрипты, а не продукт.
        по_каталогам = {}
        for файл, сп in по_файлам.items():
            кат = os.path.dirname(os.path.relpath(файл, копия)).split(os.sep)[:2]
            по_каталогам.setdefault(os.sep.join(кат) or ".", []).extend(сп)
        потолок_кат = max(1, сколько // 2)
        выбранные = []
        каталоги = sorted(по_каталогам)
        бросок.shuffle(каталоги)
        for кат in каталоги:
            сп = по_каталогам[кат][:]
            бросок.shuffle(сп)
            берём = min(len(сп), потолок_кат, сколько - len(выбранные))
            выбранные.extend(сп[:берём])
            if len(выбранные) >= сколько:
                break
        бросок.shuffle(выбранные)

        поймано, слепые = [], []
        for i, ц in enumerate(выбранные, 1):
            путь = ц["файл"]
            оригинал = open(путь, encoding="utf-8", errors="replace").read()
            строки = оригинал.splitlines(keepends=True)
            хвост = "\n" if строки[ц["строка_н"]].endswith("\n") else ""
            строки[ц["строка_н"]] = ц["стало"] + хвост
            open(путь, "w", encoding="utf-8").write("".join(строки))

            # Останавливаемся на первом покрасневшем: дальше и так ясно, что
            # порча поймана, а каждая лишняя команда стоит секунд.
            r, поймал_кто = {"код": 0, "вывод": ""}, None
            for имя_к, команда in порядок:
                r = запустить(команда, копия, 600)
                if r["код"] != 0:
                    поймал_кто = имя_к
                    break
            open(путь, "w", encoding="utf-8").write(оригинал)  # вернуть сразу

            где = f"{os.path.relpath(путь, копия)}:{ц['строка_н'] + 1}"
            if r["код"] != 0:
                # Показываем СКОЛЬКО тестов упало, а не только первое имя из вывода:
                # одно и то же имя, повторённое подряд, выглядит как ловец, а на деле
                # это просто первая строка отчёта. Число ловцов — честнее.
                упавшие = sorted(set(re.findall(
                    r"(?:FAILED\s+\S*::|_{5,}\s+)(test_\w+)", r["вывод"])))
                if not упавшие:
                    # Русские наборы этого проекта печатают «НЕТ <что проверяли>»
                    # и кода теста не имеют вовсе. Без этой ветки каждый ловец
                    # звался «тест не назвался» — то есть отчёт о зубах не
                    # говорил, ЧТО именно держит строку.
                    упавшие = [с.strip()[:48] for с in re.findall(
                        r"(?:^|\n)\s*(?:НЕТ|ПРОВАЛ|FAIL)\s+(.+)", r["вывод"])]
                    упавшие = sorted(set(упавшие))
                кто = (f"{поймал_кто}: " if поймал_кто else "")
                if not упавшие:
                    кто += "проверка не назвалась"
                elif len(упавшие) == 1:
                    кто += упавшие[0]
                else:
                    кто += f"{len(упавшие)} проверок, среди них {упавшие[0]}"
                поймано.append((где, ц["описание"], кто))
                print(f"  [{i:>2}] поймано  {где:<28} {ц['описание']:<30} → {кто}")
            else:
                слепые.append((где, ц["описание"], ц["было"].strip()[:60]))
                print(f"  [{i:>2}] СЛЕПО    {где:<28} {ц['описание']:<34} → прогон остался зелёным")

    всего = len(поймано) + len(слепые)
    print(f"\n  Поймано {len(поймано)} из {всего}. Слепых пятен: {len(слепые)}.")
    if слепые:
        print("\n  Слепые пятна — здесь код можно сломать, и никто не заметит:")
        for где, описание, код in слепые:
            print(f"    · {где}  {описание}")
            print(f"      {код}")
    доля = len(поймано) / всего if всего else 0
    print(f"\n  Доля пойманного: {доля:.0%}")

    # Записываем замер в настройки: иначе строка «умеет краснеть» в справке
    # остаётся словом. Пишем и прицел, и дату — замер без них ничего не значит.
    путь_к = os.path.join(корень, CONFIG_NAME)
    try:
        конфиг["порчи_проверены"] = dict(
            когда=datetime.now(timezone.utc).astimezone().isoformat(timespec="seconds"),
            прицел=только or "весь проект",
            набор=", ".join(имена_набора),
            подложено=всего, поймано=len(поймано), слепых=len(слепые),
            доля=f"{доля:.0%}")
        with open(путь_к, "w", encoding="utf-8") as f:
            if yaml:
                yaml.safe_dump(конфиг, f, allow_unicode=True, sort_keys=False)
            else:
                json.dump(конфиг, f, ensure_ascii=False, indent=2)
        print(f"  Замер записан в {CONFIG_NAME}")
    except Exception as e:
        print(f"  Замер записать не смог: {e}")
    return ЗЕЛЕНО if доля >= 0.5 else КРАСНО


