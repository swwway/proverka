def прочитать_конфиг(корень):
    путь = os.path.join(корень, CONFIG_NAME)
    if not os.path.exists(путь):
        return None
    txt = open(путь, encoding="utf-8").read()
    if yaml:
        return yaml.safe_load(txt)
    return json.loads(txt)


import fcntl


class Замок:
    """Один прогон на проект за раз.

    Два прогона одного набора дерутся за одну тестовую базу и дают «database is
    locked» — то есть КРАСНОЕ, которого нет. Это худший вид вранья: не пропуск
    дефекта, а выдуманный дефект, за которым пойдут искать. Поймано на себе:
    разведка и проверка PrivateOS запустились разом, и счёт упал с 1063 до 896.

    Не смогли взять замок — это «не проверено», а не «красно».
    """

    def __init__(self, корень):
        имя = re.sub(r"[^\w]+", "-", os.path.abspath(корень)).strip("-")[-120:]
        self.путь = os.path.join("/tmp", f"proverka-{имя}.lock")
        self.файл = None

    def __enter__(self):
        self.файл = open(self.путь, "w")
        try:
            fcntl.flock(self.файл, fcntl.LOCK_EX | fcntl.LOCK_NB)
            self.взят = True
        except (OSError, BlockingIOError):
            self.взят = False
        return self

    def __exit__(self, *_):
        try:
            if self.файл:
                if self.взят:
                    fcntl.flock(self.файл, fcntl.LOCK_UN)
                self.файл.close()
        except Exception:
            pass
        return False


def режим_check(корень, слать=False):
    корень = os.path.abspath(корень)
    with Замок(корень) as з:
        if not з.взят:
            print(f"ИСХОД: НЕ ПРОВЕРЕНО — по этому проекту уже идёт другой прогон.\n"
                  f"  Два прогона дерутся за одну тестовую базу и дают выдуманное\n"
                  f"  красное. Дождись первого и запусти снова.")
            return НЕ_ПРОВЕРЕНО
        return _check_внутри(корень, слать)


def _check_внутри(корень, слать=False):
    конфиг = прочитать_конфиг(корень)
    if конфиг is None:
        print(f"Здесь проверка не заведена ({CONFIG_NAME} нет). Это не отказ — просто "
              f"меня сюда не звали.\nЗавести: proverka init {корень}")
        return НЕ_ПРОВЕРЕНО

    команды = конфиг.get("команды") or {}
    if not команды:
        # «Не проверено» звучит одинаково и когда проект ещё не настроен, и когда
        # у него ОТНЯЛИ инструменты. Второе читается как первое, и находка тонет.
        # Живой случай: XE.BOT потерял единственную проверку при перезаведении и
        # молча выглядел «ещё не настроенным». Различаем по следам прошлой жизни.
        было_ручных = конфиг.get("добавлены_вручную") or {}
        были_замеры = конфиг.get("замеры") or {}
        зубы_были = isinstance(конфиг.get("порчи_проверены"), dict)
        if было_ручных or были_замеры or зубы_были:
            следы = []
            if было_ручных:
                следы.append(f"заведённые вручную: {', '.join(было_ручных)}")
            if были_замеры:
                следы.append(f"прошлые замеры: {', '.join(были_замеры)}")
            if зубы_были:
                следы.append("замер зубами был")
            print("ИСХОД: НЕ ПРОВЕРЕНО — проверки БЫЛИ И ПРОПАЛИ, а не «ещё не заведены».")
            print(f"  Следы прошлой жизни: {'; '.join(следы)}")
            print(f"  Верни командой: proverka init <проект> --добавить \"имя=команда\"")
        else:
            print("ИСХОД: НЕ ПРОВЕРЕНО — проверки здесь ещё не заводились.")
            print(f"  Завести: proverka init {корень}")
        return НЕ_ПРОВЕРЕНО

    итоги = []
    for имя, команда in команды.items():
        r = запустить(команда, корень, CHECK_TIMEOUT)
        счёт = посчитать(r["вывод"])
        хвост = "\n".join((r["вывод"] or "").splitlines()[-25:])
        итоги.append(dict(имя=имя, команда=команда, код=r["код"], счёт=счёт,
                          секунды=r["секунды"], оборвалось=r["оборвалось"],
                          ошибка=r["ошибка"], вывод_хвост=хвост))

    найдено = сумма(итоги, "всего")
    прошло = сумма(итоги, "прошло")
    упало = сумма(итоги, "упало")
    пропущено = сумма(итоги, "пропущено")
    мигнуло = сумма(итоги, "мигнуло")
    # 127 = команды не существует, 126 = найдена, но не исполняемая.
    # И то и другое означает «проверка не запускалась», а НЕ «найден дефект продукта».
    # Путать эти два исхода нельзя: во втором случае человек идёт искать баг,
    # которого нет, а чинить надо прибор.
    def не_запустилось(t):
        if t["оборвалось"] or t["код"] is None:
            return True
        if t["код"] in (126, 127):
            return True
        return bool(re.search(r"command not found|не найдена|No such file or directory",
                              t.get("вывод_хвост") or "", re.I))

    # Два разных вида команд. У НАБОРА проверок обязан быть счётчик — «прошло 0
    # из 40» и «прошло 40» это разные вещи, и без счётчика их не различить.
    # У ВОРОТ (типы, разбор кода, заслон) счётчика не бывает по природе: код
    # возврата и есть весь ответ. Требовать от них счётчик — значит кричать
    # «не знаю» там, где всё известно, а такие крики перестают читать.
    ВОРОТНЫЕ = ("typecheck", "lint", "guard", "build", "check", "verify", "gate")
    def воротная(t):
        имя = (t["имя"] or "").lower()
        return any(в in имя for в in ВОРОТНЫЕ)

    наборы = [t for t in итоги if not воротная(t)]
    неизвестных = [t for t in наборы if t["счёт"] is None and not не_запустилось(t)]
    сорванных = [t for t in итоги if не_запустилось(t)]
    # Красное определяется ДВУМЯ признаками, а не одним. Код возврата — лишь
    # первый. Второй: счётчик говорит «упало N». Прибор, который смотрит только
    # на код, пропускает самый частый обман — «отчитался успехом, не сделав дела»:
    # живой случай XE.BOT, где самопроверка печатает «ИТОГ: 2/12», а возвращает 0.
    красных = [t for t in итоги
               if not не_запустилось(t)
               and (t["код"] not in (0, None)
                    or (t["счёт"] or {}).get("упало", 0) > 0)]

    ид = опознать(корень, (конфиг.get("опознавание_работающего") or {}).get("команда"))

    # ── исход ────────────────────────────────────────────────────────────────
    if красных:
        исход = КРАСНО
    elif сорванных or неизвестных:
        исход = НЕ_ПРОВЕРЕНО
    elif not наборы:
        # только ворота, ни одного набора проверок поведения. Типы сходятся —
        # это ещё не значит, что оно работает.
        исход = НЕ_ПРОВЕРЕНО
    elif найдено is None or найдено == 0:
        # код возврата 0 при нуле запущенных проверок — это НЕ зелёное
        исход = НЕ_ПРОВЕРЕНО
    elif прошло == 0:
        # нашлось много, а прошло ноль — значит всё пропущено или отфильтровано.
        # Живой случай: отчёт «expected 0, skipped 40» глазом читается как «ok».
        исход = НЕ_ПРОВЕРЕНО
    elif ид.get("всё_в_коммите") is False:
        # проверяли то, чего нет ни в одном коммите — доказать что именно, нельзя
        исход = НЕ_ПРОВЕРЕНО
    else:
        исход = ЗЕЛЕНО

    # ── Требуемые виды против имеющихся ──────────────────────────────────────
    # Определитель знает, ЧТО обязательно проверять этому проекту. Без этой
    # сшивки он говорил в пустоту: «браузерный сквозной обязателен», а вердикт
    # рядом печатал ЗЕЛЕНО на одной проверке поведения. Зелёное, которое не
    # покрывает обязательного вида, — это «не знаю», а не «всё хорошо».
    нет_вида = []
    try:
        for вид, улика, решено in виды_проверок(
                определить(корень),
                (конфиг.get("деньги") or {}).get("есть")
                if isinstance(конфиг.get("деньги"), dict) else None):
            ключ = вид.split(":")[0].strip()
            if ключ in (конфиг.get("перебито_видами") or {}):
                continue
            if not решено:
                нет_вида.append((вид, улика))
                continue
            слова = ПОДСКАЗКИ_ВИДОВ.get(ключ)
            if not слова:
                continue  # «проверки поведения» покрыты самим фактом счётчиков
            # Явное сопоставление важнее угадывания. Угадывать по названию —
            # та же ошибка, что определять по объявлениям вместо кода: команда
            # «самопроверка-на-проде» покрывает инварианты, но ни одно слово-подсказка
            # в неё не попадает, и получался ложный пробел.
            покрыто = (конфиг.get("виды_покрыты") or {})
            if ключ in покрыто and покрыто[ключ] in команды:
                continue
            if not any(с in и.lower() for и in команды for с in слова):
                нет_вида.append((вид, улика))
    except Exception:
        нет_вида = []
    д = конфиг.get("деньги") if isinstance(конфиг.get("деньги"), dict) else None
    if д and д.get("есть") is False and д.get("мера_на_тот_день") is not None:
        сейчас = мера_денег(корень)
        было = д["мера_на_тот_день"]
        if сейчас > было * 2 + 30:
            нет_вида.append((
                "эталоны: ОТВЕТ УСТАРЕЛ",
                f"на {д['когда'][:10]} денежных понятий было {было}, сейчас {сейчас} — "
                f"спроси заново: proverka profile <проект> --деньги да|нет"))
    if нет_вида and исход == ЗЕЛЕНО:
        исход = НЕ_ПРОВЕРЕНО

    слово = {ЗЕЛЕНО: "ЗЕЛЕНО", КРАСНО: "КРАСНО", НЕ_ПРОВЕРЕНО: "НЕ ПРОВЕРЕНО"}[исход]
    срезы = конфиг.get("срезы") or {}
    print("=" * 68)
    print(f"ПРОЕКТ: {os.path.basename(корень)}    УРОВЕНЬ: {конфиг.get('уровень','обычный')}"
          f"    ИСХОД: {слово}")
    print("=" * 68)

    # 1. Знаменатель
    if срезы:
        print(f"1. ЗНАМЕНАТЕЛЬ   срезов {len(срезы)}: " +
              ", ".join(f"{k} ({v})" for k, v in срезы.items()))
    else:
        print("1. ЗНАМЕНАТЕЛЬ   срезы не заведены — уровень назначен на весь проект")
    if нет_вида:
        print(f"   ОБЯЗАТЕЛЬНО, НО НЕ ПОКРЫТО ({len(нет_вида)}):")
        for вид, улика in нет_вида:
            print(f"     ✗ {вид:<30} ← {улика[:70]}")

    # 2. Найдено / запущено / пропущено — против «отчитался, не сделав дела»
    if not наборы:
        print("2. СЧЁТЧИКИ      ⚠ проверок ПОВЕДЕНИЯ нет ни одной — только ворота "
              f"({', '.join(t['имя'] for t in итоги)}). Типы сходятся — это ещё не «работает»")
    elif найдено is None:
        print("2. СЧЁТЧИКИ      ⚠ распознать не удалось ни у одной команды — "
              "это «не знаю», а не «всё хорошо»")
    else:
        строка = f"найдено {найдено} · прошло {прошло} · упало {упало} · пропущено {пропущено}"
        if мигнуло:
            строка += f" · мигнуло {мигнуло}"
        print(f"2. СЧЁТЧИКИ      {строка}")
    if неизвестных:
        print(f"                 ⚠ без счётчика: {', '.join(t['имя'] for t in неизвестных)}")

    # 3. Что НЕ дошло до запуска
    if сорванных:
        def почему(t):
            if t["ошибка"]:
                return t["ошибка"]
            if t["код"] == 127:
                return "команды не существует"
            if t["код"] == 126:
                return "найдена, но не исполняемая"
            return "нет кода возврата"
        print("3. НЕ ДОШЛО      " + "; ".join(
            f"{t['имя']}: {почему(t)}" for t in сорванных))
    elif пропущено:
        print(f"3. НЕ ДОШЛО      пропущено {пропущено} — зелёным не красится")
    else:
        print("3. НЕ ДОШЛО      ничего: все команды дошли до конца и вернули код")

    # 4. Умеет ли краснеть
    зубы = конфиг.get("порчи_проверены")
    if isinstance(зубы, dict):
        набор_з = зубы.get("набор")
        print(f"4. УМЕЕТ КРАСНЕТЬ поймано {зубы.get('поймано')} из {зубы.get('подложено')} "
              f"порч ({зубы.get('доля')}), прицел: {зубы.get('прицел')}, "
              f"{(зубы.get('когда') or '')[:10]}")
        # Чем мерили — часть замера: доля, снятая одной командой, и доля,
        # снятая всем набором, — разные числа, и путать их молча нельзя.
        print(f"                 мерено набором: {набор_з}" if набор_з else
              "                 ⚠ замер снят до того, как зубы стали мерить весь "
              "набор — перемерь: proverka teeth")
    else:
        print("4. УМЕЕТ КРАСНЕТЬ ⚠ на этом проекте не доказано — порчи не подкладывались")

    # 5. С чего снято
    хвост = ид.get("коммит") or "не git"
    if ид.get("всё_в_коммите") is False:
        хвост += f" ⚠ + {ид.get('грязных_файлов')} файлов вне коммита"
    if ид.get("живая_сборка"):
        хвост += f" · живое: {ид['живая_сборка']}"
    печать_время = datetime.now().strftime("%d.%m %H:%M")
    print(f"5. С ЧЕГО СНЯТО  {хвост} · {печать_время}")

    print("-" * 68)
    for t in итоги:
        метка = "ok " if t["код"] == 0 else ("КРАСНО" if t["код"] else "СОРВАЛОСЬ")
        н = t["счёт"]["всего"] if t["счёт"] else "?"
        print(f"  {метка:<9} {t['имя']:<18} код {str(t['код']):<5} "
              f"{t['секунды']:>7} с   проверок {н}")
    print("=" * 68)

    # Молчим на зелёном — иначе отчёты превращаются в шум и их перестают читать.
    # Тишину сторожит отдельная команда (watch), так что молчание тут безопасно.
    if слать and исход != ЗЕЛЕНО:
        значок = "🔴" if исход == КРАСНО else "🟡"
        строки = [f"{значок} {os.path.basename(корень)}: "
                  f"{'красное' if исход == КРАСНО else 'НЕ ПРОВЕРЕНО'}"]
        if найдено is not None:
            строки.append(f"проверок {найдено}, упало {упало}, пропущено {пропущено}")
        for t in красных + сорванных:
            строки.append(f"• {t['имя']}: код {t['код']}")
        for t in неизвестных:
            строки.append(f"• {t['имя']}: счётчик не распознан")
        if ид.get("всё_в_коммите") is False:
            строки.append(f"• работает код вне коммита ({ид.get('грязных_файлов')} файлов)")
        в_телеграм("\n".join(строки))
    return исход


