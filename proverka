# watch — сторож против ТИШИНЫ.
# Обычная проверка отвечает «зелено/красно», когда её запустили. Но если её
# вообще не запустили, она не отвечает ничего — и это неотличимо от «всё хорошо».
# Сторож смотрит на две вещи: жива ли строка в расписании и свеж ли её лог.
# ─────────────────────────────────────────────────────────────────────────────

def в_телеграм(текст):
    """Отправить итог в Telegram. Ничего не настроено — молча не отправляем.

    Где берутся токен и адресат, по порядку:
      1. переменные окружения PROVERKA_TG_TOKEN и PROVERKA_TG_CHAT;
      2. файл, названный в PROVERKA_TG_ENV;
      3. ~/.config/proverka/telegram.env

    Формат файла (две строки):
      TELEGRAM_BOT_TOKEN=123456:AA...
      TELEGRAM_ADMIN_CHAT_ID=123456789

    Файлу положены права 600: внутри токен, а токен — это доступ к боту.
    """
    токен = os.environ.get("PROVERKA_TG_TOKEN")
    чат = os.environ.get("PROVERKA_TG_CHAT")
    if not (токен and чат):
        env = os.environ.get("PROVERKA_TG_ENV") or os.path.expanduser(
            "~/.config/proverka/telegram.env")
        if not os.path.exists(env):
            return False
        for строка in open(env, encoding="utf-8", errors="replace"):
            if строка.startswith("TELEGRAM_BOT_TOKEN="):
                токен = строка.split("=", 1)[1].strip().strip('"\'')
            elif строка.startswith("TELEGRAM_ADMIN_CHAT_ID="):
                чат = строка.split("=", 1)[1].strip().strip('"\'')
    if not (токен and чат):
        return False
    try:
        subprocess.run(["curl", "-s", "-X", "POST",
                        f"https://api.telegram.org/bot{токен}/sendMessage",
                        "-d", f"chat_id={чат}", "--data-urlencode", f"text={текст}"],
                       capture_output=True, timeout=30)
        return True
    except Exception:
        return False
    токен = чат = None
    for строка in open(env, encoding="utf-8", errors="replace"):
        if строка.startswith("TELEGRAM_BOT_TOKEN="):
            токен = строка.split("=", 1)[1].strip().strip('"\'')
        elif строка.startswith("TELEGRAM_ADMIN_CHAT_ID="):
            чат = строка.split("=", 1)[1].strip().strip('"\'')
    if not (токен and чат):
        return False
    try:
        subprocess.run(["curl", "-s", "-X", "POST",
                        f"https://api.telegram.org/bot{токен}/sendMessage",
                        "-d", f"chat_id={чат}", "--data-urlencode", f"text={текст}"],
                       capture_output=True, timeout=30)
        return True
    except Exception:
        return False


# ─────────────────────────────────────────────────────────────────────────────
# gate — турникет на отправке. Момент, когда работа объявляется сделанной.
#
# Не на коммите: коммитов у агента десятки, заслон на каждом сделает работу
# невыносимой и его снимут. На отправке — работа покидает машину.
#
# ПОТОЛОК СКОРОСТИ: бегут только команды с замером меньше 60 секунд. Замер уже
# записан разведкой. Всё длинное уходит в ночной прогон — иначе турникет
# начнёт стоить минуты на каждый push, и его обойдут навсегда.
#
# Честно: `git push --no-verify` обходит любой местный хук. Настоящий замок —
# только на стороне GitHub. Здесь заслон, который ловит забывчивость, а не злой
# умысел; злой умысел ловят обязательные проверки на запросе.
# ─────────────────────────────────────────────────────────────────────────────

ПОТОЛОК_ТУРНИКЕТА = int(os.environ.get("PROVERKA_GATE_SEC", "60"))


def режим_gate(корень, потолок=None):
    корень = os.path.abspath(корень)
    потолок = потолок or ПОТОЛОК_ТУРНИКЕТА
    конфиг = прочитать_конфиг(корень)
    if конфиг is None:
        print("Турникет: проверка здесь не заведена — пропускаю.\n"
              f"  Завести: proverka init {корень}")
        return ЗЕЛЕНО

    def git(*a):
        try:
            return subprocess.run(["git", "-C", корень, *a], capture_output=True,
                                  text=True, timeout=20).stdout
        except Exception:
            return ""

    # что уезжает: всё, чего нет на удалённом
    тронуто = [с for с in git("diff", "--name-only", "@{u}..HEAD").splitlines() if с]
    if not тронуто:
        тронуто = [с for с in git("diff", "--name-only", "HEAD~1..HEAD").splitlines() if с]
    рабочие = [ф for ф in тронуто
               if not ф.endswith((".md", ".txt", ".yml", ".yaml", ".json", ".lock"))
               and "/docs/" not in ф and not ф.startswith("docs/")]

    print(f"Турникет: {os.path.basename(корень)} · уезжает файлов {len(тронуто)}, "
          f"из них рабочих {len(рабочие)}")
    if not рабочие:
        print("  Тронуты только тексты и настройки — пропускаю.")
        return ЗЕЛЕНО

    команды = конфиг.get("команды") or {}
    замеры = конфиг.get("замеры") or {}
    быстрые = {к: v for к, v in команды.items()
               if (замеры.get(к) or {}).get("секунды", 999) <= потолок}
    долгие = [к for к in команды if к not in быстрые]
    if not быстрые:
        print(f"  Быстрых команд нет (потолок {потолок} с). Длинное — в ночной прогон.")
        print(f"  ИСХОД: НЕ ПРОВЕРЕНО — турникету нечем проверить.")
        return НЕ_ПРОВЕРЕНО

    плохо, поведение_счёт = [], 0
    for имя, команда in быстрые.items():
        r = запустить(команда, корень, потолок * 3)
        счёт = посчитать(r["вывод"]) or {}
        if счёт.get("всего"):
            поведение_счёт += счёт["всего"]
        упало = счёт.get("упало", 0)
        знак = "ok " if r["код"] == 0 and not упало else "КРАСНО"
        print(f"  {знак:<7} {имя:<20} код {r['код']}  {r['секунды']:>6} с  "
              f"проверок {счёт.get('всего', '?')}")
        if r["код"] != 0 or упало:
            плохо.append(имя)

    # Поведение измерено или только ворота? Ворота (типы, разбор кода) отвечают
    # кодом возврата и НЕ печатают счётчик. Если ни одна быстрая команда не дала
    # счётчика — значит поведение не измерено вовсе, и зелёное тут было бы тем же
    # обманом, что «код 0 при нуле запущенных проверок», только ярусом выше.
    # Живой случай ERP: typecheck и lint прошли за 52 и 50 с, а test (470 с) и
    # денежный ярус (205 с) в турникет не влезли — он напечатал ЗЕЛЕНО.
    покрыто_явно = (конфиг.get("виды_покрыты") or {}).get("проверки поведения")
    поведение_измерено = (покрыто_явно in быстрые) if покрыто_явно else bool(поведение_счёт)

    if долгие:
        print(f"  (в ночной прогон, сюда не берутся: {', '.join(долгие)})")
    if плохо:
        print(f"\n  ИСХОД: КРАСНО — {', '.join(плохо)}. Отправка остановлена.")
        print("  Обойти осознанно: git push --no-verify (останется видно в истории)")
        return КРАСНО
    if not поведение_измерено:
        print(f"\n  ИСХОД: НЕ ПРОВЕРЕНО — быстрыми проверками ПОВЕДЕНИЕ не измерено.")
        print(f"  Прошли только ворота ({', '.join(быстрые)}), а наборы проверок "
              f"не уложились в {потолок} с.")
        print(f"  Отправку не держу, но зелёным это назвать нельзя.")
        return НЕ_ПРОВЕРЕНО
    print(f"\n  ИСХОД: ЗЕЛЕНО — поведение измерено ({поведение_счёт} проверок), "
          f"можно отправлять.")
    return ЗЕЛЕНО


