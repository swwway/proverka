# ─────────────────────────────────────────────────────────────────────────────
# profile — какие ВИДЫ проверок обязательны этому проекту.
#
# Уровень «1/2/3» назначает человек и потому забывает. Здесь набор выводится из
# СВОЙСТВ проекта, которые видно машиной. Главное правило, ради которого всё:
#
#     БРАУЗЕР НУЖЕН ТАМ, ГДЕ ПРОЕКТ САМ ОТДАЁТ ЧЕЛОВЕКУ ЭКРАН.
#
# У телеграм-бота экран чужой — телеграмовский. Проверять там кнопки бессмысленно;
# нужен другой вид: сквозная проверка через тот же чужой клиент.
#
# Два закона, купленные ошибками первого прогона по десяти проектам:
#   1. Определяем по САМОМУ КОДУ, а не по объявлениям зависимостей. У телеграм-бота
#      файла зависимостей нет вовсе — определение по объявлениям дало ложное
#      «клиента нет». THE A OS с 76 браузерными сценариями был объявлен «браузер
#      не нужен», потому что я требовал наличия каркаса вроде React, а там чистый JS.
#   2. Каждое решение несёт УЛИКУ — файл, который его доказывает. Определитель,
#      который врёт молча, хуже отсутствующего: он создаёт ложную уверенность.
# ─────────────────────────────────────────────────────────────────────────────

ПРОПУСК_ОБХОДА = ("node_modules", ".git", ".next", "dist", "build", "__pycache__",
                  ".venv", "venv", "coverage", "evidence", "backups", "logs",
                  ".claude")

КЛИЕНТЫ = re.compile(
    r"""(?:^|\n)\s*(?:from|import)\s+(telegram|aiogram)(?:\.\w+)*\s+import\b"""
    r"""|(?:^|\n)\s*import\s+(telegram|aiogram)\b"""
    r"""|from\s+["'](grammy|telegraf|node-telegram[\w-]*)["']"""
    r"""|require\(\s*["'](grammy|telegraf|node-telegram[\w-]*)["']""")

БАЗЫ = re.compile(
    r"""(?:from|import)\s+["']?(prisma|@prisma/client|sqlalchemy|better-sqlite3"""
    r"""|psycopg2?|sqlite3|pg)\b|require\(\s*["'](better-sqlite3|pg|sqlite3)""", re.I)


def _обойти(корень, что_делать, предел_файлов=40000):
    """Один обход дерева. Возвращает, когда что_делать скажет «хватит»."""
    n = 0
    for путь, папки, файлы in os.walk(корень):
        папки[:] = [d for d in папки
                    if d not in ПРОПУСК_ОБХОДА and not d.startswith("audit_")]
        for ф in sorted(файлы):
            n += 1
            if n > предел_файлов:
                return
            if что_делать(путь, ф) is False:
                return


def определить(корень):
    """-> dict(свойство -> (да/нет, улика))."""
    корень = os.path.abspath(корень)
    св = {
        "свой_экран": [False, None],
        "чужой_клиент": [False, None],
        "типы": [False, None],
        "база": [False, None],
        "браузерных_сценариев": [0, None],
    }

    for f in ("index.html", "public/index.html", "app/index.html", "src/index.html"):
        if os.path.exists(os.path.join(корень, f)):
            св["свой_экран"] = [True, f"есть {f} — проект отдаёт страницу сам"]
            break
    for f in ("tsconfig.json", "mypy.ini", "pyproject.toml"):
        if os.path.exists(os.path.join(корень, f)):
            св["типы"] = [True, f"есть {f}"]
            break

    def смотреть(путь, ф):
        отн = os.path.relpath(os.path.join(путь, ф), корень)
        if ф == "index.html" and not св["свой_экран"][0]:
            св["свой_экран"] = [True, f"отдаёт страницу сам: {отн}"]
        if ф.endswith((".spec.js", ".spec.ts", ".e2e.ts", ".e2e.js")) or \
           (ф.endswith((".spec.mjs",))):
            св["браузерных_сценариев"][0] += 1
            if not св["браузерных_сценариев"][1]:
                св["браузерных_сценариев"][1] = отн
        if ф.endswith((".tsx", ".jsx", ".vue", ".svelte")):
            # улика не должна быть тестовым файлом: «страница __tests__/x.tsx»
            # читается как доказательство экрана, а доказывает лишь наличие теста
            тестовый = ("__tests__" in отн or "test" in ф.lower()
                        or "spec" in ф.lower() or "fixture" in отн)
            if not тестовый and (not св["свой_экран"][0]
                                 or "страница" not in (св["свой_экран"][1] or "")):
                if not св["свой_экран"][0]:
                    св["свой_экран"] = [True, f"страница {отн}"]
        if not ф.endswith((".py", ".ts", ".js", ".mjs", ".tsx")):
            return
        if св["чужой_клиент"][0] and св["база"][0]:
            return
        try:
            т = open(os.path.join(путь, ф), encoding="utf-8", errors="replace").read(150000)
        except Exception:
            return
        if not св["чужой_клиент"][0]:
            m = КЛИЕНТЫ.search(т)
            if m:
                св["чужой_клиент"] = [True, f"{отн}: {m.group(0).strip()[:40]}"]
        if not св["база"][0]:
            m = БАЗЫ.search(т)
            if m:
                св["база"] = [True, f"{отн}: {m.group(0).strip()[:40]}"]

    _обойти(корень, смотреть)

    if not св["свой_экран"][0] and св["браузерных_сценариев"][0] > 0:
        св["свой_экран"] = [True, f"уже написано браузерных сценариев: "
                                  f"{св['браузерных_сценариев'][0]} "
                                  f"({св['браузерных_сценариев'][1]})"]
    return {к: tuple(v) for к, v in св.items()}


ДЕНЕЖНЫЕ_СЛОВА = re.compile(
    r"\b(amount|currency|balance|commission|payout|invoice|ledger|payment|"
    r"сумм|валют|баланс|комисси|выплат|проводк|платеж|начислен)", re.I)


def мера_денег(корень):
    """Сколько денежных понятий в исходниках. Не для решения — для СРАВНЕНИЯ.

    Решение принимает владелец («есть ли величина, которую складывают, переносят
    или должны»), и оно записано с датой. Но ответ «нет» может протухнуть: у
    THE A OS деньги появятся позже. Тогда эта мера вырастет, и система скажет
    «спроси заново» — вместо того чтобы молча жить со старым ответом.
    """
    n = [0]
    def смотреть(путь, ф):
        if not ф.endswith((".ts", ".tsx", ".js", ".mjs", ".py")):
            return
        if "test" in ф.lower() or "spec" in ф.lower():
            return
        try:
            n[0] += len(ДЕНЕЖНЫЕ_СЛОВА.findall(
                open(os.path.join(путь, ф), encoding="utf-8", errors="replace").read(120000)))
        except Exception:
            pass
        if n[0] > 3000:
            return False
    _обойти(корень, смотреть)
    return n[0]


def виды_проверок(св, деньги=None):
    """Обязательные виды. деньги: True/False/None — None значит «не спрашивали»."""
    сп = [("проверки поведения", "нужны всегда", True)]
    if св["типы"][0]:
        сп.append(("разбор типов", св["типы"][1], True))
    if св["свой_экран"][0]:
        сп.append(("браузерный сквозной", св["свой_экран"][1], True))
    if св["чужой_клиент"][0] and not св["свой_экран"][0]:
        сп.append(("сквозной через чужой клиент", св["чужой_клиент"][1], True))
    elif св["чужой_клиент"][0]:
        # Обращение к телеграму есть, но свой экран тоже есть — значит телеграм
        # тут канал уведомлений, а не рабочая поверхность. Живой случай: кокпит
        # шлёт тревоги в телеграм, а люди работают в браузере.
        сп.append(("телеграм — канал уведомлений, не рабочее место",
                   f"{св['чужой_клиент'][1]} — но свой экран есть, "
                   f"значит человек работает не там", True))
    if деньги is True:
        сп.append(("эталоны: числа приходят снаружи", "владелец сказал: деньги есть", True))
    elif деньги is None:
        # НЕ угадываем по числу слов в коде: порог произволен, а ошибка тихая.
        # Пока владелец не ответил — это «не определено», и оно не красится зелёным.
        сп.append(("эталоны: НЕ ОПРЕДЕЛЕНО",
                   "не спрошено: есть ли величина, которую складывают, переносят "
                   "или кому-то должны", False))
    if св["база"][0]:
        сп.append(("инварианты на копии базы", св["база"][1], True))
    return сп


