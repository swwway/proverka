# Запуск команды. Код возврата берём напрямую у процесса — через трубу его
# читать нельзя, там окажется код последней команды конвейера (ловушка из GOTCHAS).
# ─────────────────────────────────────────────────────────────────────────────

_НОДА_КЭШ = None


def _путь_с_нодой():
    """PATH, в котором точно виден npm/npx.

    На этой машине npm не лежит в PATH даже у входного сеанса — только node
    заведён ссылкой. Из-за этого разведка объявляла рабочие node-проекты
    «не запустились»: `npm test` падал с кодом 127, хотя тесты живые.
    Собственные ворота одного из проектов решают это тем же способом — ищут каталог node
    сами. Повторяем: берём самую свежую версию nvm плюс обычные места.
    """
    global _НОДА_КЭШ
    if _НОДА_КЭШ is not None:
        return _НОДА_КЭШ
    куски = []
    nvm = os.path.expanduser("~/.nvm/versions/node")
    if os.path.isdir(nvm):
        версии = sorted(os.listdir(nvm), reverse=True)
        for в in версии:
            b = os.path.join(nvm, в, "bin")
            if os.path.exists(os.path.join(b, "npm")):
                куски.append(b)
                break
    for b in ("/usr/local/bin", os.path.expanduser("~/.local/bin")):
        if os.path.isdir(b):
            куски.append(b)
    _НОДА_КЭШ = ":".join(куски + [os.environ.get("PATH", "")])
    return _НОДА_КЭШ


def _убить_группу(p, добить_через=5):
    """Снять всю группу процессов и вернуть то, что успело напечататься.

    Сначала мягко (SIGTERM всей группе), потом жёстко (SIGKILL) — прогонам дают
    закрыть за собой контейнеры и временные базы, но не дают зависнуть навсегда.
    Промежуточный вывод не теряем: по нему человек и понимает, где встало.
    """
    import signal
    частично = ""
    try:
        os.killpg(os.getpgid(p.pid), signal.SIGTERM)
    except Exception:
        try:
            p.terminate()
        except Exception:
            pass
    try:
        частично = p.communicate(timeout=добить_через)[0] or ""
    except Exception:
        try:
            os.killpg(os.getpgid(p.pid), signal.SIGKILL)
        except Exception:
            try:
                p.kill()
            except Exception:
                pass
        try:
            частично = p.communicate(timeout=добить_через)[0] or ""
        except Exception:
            частично = ""
    if isinstance(частично, bytes):
        частично = частично.decode("utf-8", "replace")
    return частично


def запустить(команда, cwd, timeout):
    нач = time.time()
    окружение = dict(os.environ, PATH=_путь_с_нодой())
    # ОБРЫВ ОБЯЗАН УБИВАТЬ ВСЮ ГРУППУ, А НЕ ОДНУ ОБОЛОЧКУ.
    #
    # `shell=True` даёт дерево: оболочка → пакетный менеджер → сам прогон →
    # его рабочие. Таймаут `subprocess` убивает ТОЛЬКО прямого ребёнка —
    # оболочку, — и внуки остаются жить сиротами. Замер 14.08 на боевом проекте: так
    # пережили обрыв рабочие процессы `vitest`, и это на общем хосте, где рядом
    # идёт боевой выкат. Своя группа процессов (`start_new_session`) плюс
    # `killpg` закрывают весь куст разом.
    try:
        p = subprocess.Popen(команда, shell=True, cwd=cwd, env=окружение,
                             stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                             text=True, errors="replace", start_new_session=True)
    except Exception as e:
        return dict(код=None, вывод="", секунды=round(time.time() - нач, 1),
                    оборвалось=False, ошибка=str(e))
    try:
        вывод = p.communicate(timeout=timeout)[0] or ""
        return dict(код=p.returncode, вывод=вывод, секунды=round(time.time() - нач, 1),
                    оборвалось=False, ошибка=None)
    except subprocess.TimeoutExpired:
        частично = _убить_группу(p)
        return dict(код=None, вывод=частично, секунды=round(time.time() - нач, 1),
                    оборвалось=True, ошибка=f"не уложилось в {timeout} с")
    except Exception as e:
        return dict(код=None, вывод="", секунды=round(time.time() - нач, 1),
                    оборвалось=False, ошибка=str(e))


# ─────────────────────────────────────────────────────────────────────────────
# Идентификатор того, что РЕАЛЬНО работает.
# Не только SHA: грязное дерево означает, что работающий код не лежит ни в одном
# коммите — ровно случай телеграм-бота, который поднялся на незакоммиченных файлах.
# ─────────────────────────────────────────────────────────────────────────────

def опознать(корень, доп_команда=None):
    ид = {}
    def git(*a):
        try:
            # quotepath=false — иначе кириллические имена приходят в виде
            # "\320\232\320\220..." и любой поиск по имени файла промахивается.
            return subprocess.run(["git", "-C", корень, "-c", "core.quotepath=false", *a],
                                  capture_output=True, text=True, timeout=15).stdout.strip()
        except Exception:
            return ""
    sha = git("rev-parse", "--short", "HEAD")
    if sha:
        ид["коммит"] = sha
        # Грязь считаем ТОЛЬКО по своей папке. Проект может быть частью большего
        # репозитория (feedback-бот — ссылка внутрь репозитория THE A OS), и тогда
        # чужие правки в соседних папках объявляли бы его «работает не то, что в git».
        верх = git("rev-parse", "--show-toplevel")
        if верх and os.path.abspath(верх) != os.path.abspath(корень):
            ид["часть_репозитория"] = os.path.relpath(корень, верх)
            грязь = git("status", "--porcelain", "--", корень)
        else:
            грязь = git("status", "--porcelain")
        # Свои же файлы не считаем работающим кодом: настройки проверки и
        # задание на непокрытое прибор пишет сам, и без этого он объявлял бы
        # «работает не то, что в git» из-за собственной записи.
        СВОИ = (CONFIG_NAME, "ЗАДАНИЕ-ПРОВЕРКИ.md")
        изменённые = [s for s in грязь.splitlines()
                      if s[:2].strip() and not s.startswith("??")
                      and not any(в in s for в in СВОИ)]
        ид["грязных_файлов"] = len(изменённые)
        ид["всё_в_коммите"] = (len(изменённые) == 0)
    else:
        ид["коммит"] = None
        ид["всё_в_коммите"] = None
    if доп_команда:
        r = запустить(доп_команда, корень, 60)
        ид["живая_сборка"] = (r["вывод"] or "").strip().splitlines()[-1:] or [None]
        ид["живая_сборка"] = ид["живая_сборка"][0]
    return ид


